---
import Photo from './Photo.astro';
import type { Prize } from '../lib/types';

interface Props { prizes: Prize[] }
const { prizes } = Astro.props;
---

<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    prizes.map((p) => (
      <li class="card overflow-hidden">
        <Photo image={p.image} alt={p.title} width={700} ratio="4/3" fit="contain" label="Foto hadiah" class="bg-alt p-4" />
        <div class="p-5">
          {p.quantity != null && <p class="font-display text-5xl leading-none text-primary">{p.quantity}</p>}
          <h3 class="mt-2 text-base">{p.title}</h3>
          {p.description && <p class="mt-1 text-sm text-ink-soft">{p.description}</p>}
        </div>
      </li>
    ))
  }
</ul>
