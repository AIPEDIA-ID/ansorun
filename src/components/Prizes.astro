---
import Photo from './Photo.astro';
import type { Prize } from '../lib/types';

interface Props { prizes: Prize[] }
const { prizes } = Astro.props;
---

<div class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
  {
    prizes.map((p) => (
      <div>
        <Photo image={p.image} alt={p.title} width={700} ratio="16/10" fit="contain" label="Foto hadiah" />
        <p class="mt-3 font-display text-5xl leading-none text-primary">{p.quantity}</p>
        <h3 class="mt-1 text-base">{p.title}</h3>
        {p.description && <p class="mt-1 text-sm">{p.description}</p>}
      </div>
    ))
  }
</div>
