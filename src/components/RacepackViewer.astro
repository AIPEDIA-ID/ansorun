---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { md } from '../lib/text';
import { ui } from '../config';
import type { RacepackItem } from '../lib/types';

interface Props { venue: string; schedule: string; items: RacepackItem[] }
const { venue, schedule, items } = Astro.props;
---

<div class="card-dark grid gap-8 p-6 md:p-8 lg:grid-cols-[1fr_1.1fr]" data-racepack>
  <div>
    <h3 class="text-xl text-white">{venue}</h3>
    <div class="entry mt-2 text-sm" set:html={md(schedule)} />
    <div class="mt-6 space-y-3" role="tablist" aria-orientation="vertical">
      {
        items.map((it, i) => (
          <button type="button" role="tab" class="rp-item" id={`rp-tab-${i}`} aria-controls={`rp-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="rp-icon"><Icon name={it.icon ?? 'star'} size={20} /></span>
            <span>
              <span class="block font-heading text-[15px] font-bold">{it.title}</span>
              <span class="block text-sm text-white/65">{it.description}</span>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="relative">
    {
      items.map((it, i) => (
        <div role="tabpanel" id={`rp-panel-${i}`} aria-labelledby={`rp-tab-${i}`} hidden={i !== 0} class="relative h-full min-h-[320px] overflow-hidden rounded-[4px] bg-darker">
          {it.image ? (
            <Photo image={it.image} alt={it.title} width={900} ratio="1/1" class="h-full" />
          ) : (
            <div class="flex h-full min-h-[320px] items-center justify-center font-heading text-sm font-extrabold uppercase tracking-[.25em] text-white/70" style="background:var(--t-dark)">{ui.comingSoon}</div>
          )}
          {it.caption && (
            <span class="absolute bottom-4 left-4 rounded-full bg-accent px-4 py-1.5 text-xs font-bold text-white">{it.caption}</span>
          )}
        </div>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-racepack]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        tabs.forEach((x, j) => {
          x.setAttribute('aria-selected', String(i === j));
          panels[j].hidden = i !== j;
        });
      }),
    );
  });
</script>
