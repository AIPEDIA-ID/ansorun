---
/**
 * Tanggal + QR pendaftaran (hasil ekstrak dari KV lama, public/brand/hero-date|hero-qr).
 * Dipakai dua kali di hero: baris di band (layout ringkas) dan melayang di KV (layout satu layar).
 */
import { withBase } from '../config';
import { cmsAttr } from '../lib/cms';
interface Props { url?: string | null; label?: string }
const { url, label = 'Daftar' } = Astro.props;
const Tag = url ? 'a' : 'span';
const attrs = url ? { href: url, rel: 'noopener', 'aria-label': label, ...cmsAttr('href', 'registrationUrl', 'Link pendaftaran') } : {};
---

<img class="x-date" src={withBase('/brand/hero-date.webp')} alt="31 Januari 2027, kategori 5K dan 10K" width="660" height="264" loading="lazy" />
<Tag class="x-qr" {...attrs}>
  <img src={withBase('/brand/hero-qr.webp')} alt="QR pendaftaran online" width="627" height="241" loading="lazy" />
</Tag>
