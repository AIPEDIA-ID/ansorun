---
import { getSiteData } from '../lib/content';
import { rich } from '../lib/text';

interface Props { crumb: string }
const { crumb } = Astro.props;
const { site } = await getSiteData();
---

<section class="page-banner">
  <div class="stripe-stack" aria-hidden="true"></div>
  <div class="container-x relative">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Beranda</a> <span class="mx-2 opacity-60">&rsaquo;</span> <span class="current">{crumb}</span>
    </nav>
    <div class="mt-16 flex flex-wrap items-end justify-between gap-6">
      <h1 class="rich" set:html={rich(site.bannerTitle)} />
      <p class="text-right text-lg font-light leading-snug">
        {site.tagline}<br />{site.categories}
      </p>
    </div>
  </div>
</section>
