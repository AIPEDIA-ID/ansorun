---
import { getSiteData, formatDate } from '../lib/content';
import { ui } from '../config';
import Newsletter from './Newsletter.astro';
import SocialLinks from './SocialLinks.astro';

const { site } = await getSiteData();
---

<aside class="space-y-0">
  <div class="widget">
    <h2 class="widget-title">{ui.eventInfoTitle}</h2>
    <div class="widget-body">
      <ul class="plain">
        <li><strong>Tanggal:</strong> {formatDate(site.eventDate, { dateStyle: 'long' })}</li>
        <li><strong>Lokasi:</strong> {site.location}</li>
        <li><strong>Kategori:</strong> {site.categories}</li>
      </ul>
      {site.registrationUrl && <p class="mt-3"><a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a></p>}
    </div>
  </div>

  <Newsletter action={site.newsletterAction} />

  <div class="widget">
    <h2 class="widget-title">{ui.followUs}</h2>
    <div class="widget-body"><SocialLinks /></div>
  </div>
</aside>
