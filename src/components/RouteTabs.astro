---
import Icon from './Icon.astro';
import { img } from '../lib/datocms';
import { md } from '../lib/text';
import { ui } from '../config';
import type { RaceCategory } from '../lib/types';

interface Props { items: RaceCategory[]; registrationUrl?: string }
const { items, registrationUrl } = Astro.props;
const key = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<!-- Tab per kategori: peta besar + keterangan rute. Klik peta untuk zoom. Bisa dibuka langsung lewat #rute-10k -->
<div data-route-tabs>
  <div class="tabs-list" role="tablist" aria-label="Pilih kategori rute">
    {
      items.map((c, i) => (
        <button type="button" role="tab" class="tab-btn" data-key={key(c.name)} id={`route-tab-${i}`} aria-controls={`route-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          Kategori {c.name}
        </button>
      ))
    }
  </div>

  {
    items.map((c, i) => (
      <div role="tabpanel" class="tab-panel grid items-start gap-6 lg:grid-cols-[1.6fr_1fr]" id={`route-panel-${i}`} aria-labelledby={`route-tab-${i}`} hidden={i !== 0}>
        {c.routeMapImage ? (
          <button type="button" class="route-map" data-full={img(c.routeMapImage.url, 2400)} data-alt={c.routeMapImage.alt ?? `Peta rute ${c.name}`} aria-label={`${ui.zoomMap}: ${c.name}`}>
            <img src={img(c.routeMapImage.url, 1400)} alt={c.routeMapImage.alt ?? `Peta rute ${c.name}`} width={c.routeMapImage.width ?? 1400} height={c.routeMapImage.height ?? 788} class="block w-full" loading="eager" decoding="async" />
            <span class="route-map-hint"><Icon name="zoom" size={14} /> {ui.zoomMap}</span>
          </button>
        ) : (
          <div class="card grid min-h-[240px] place-items-center p-8 text-center tbd">{ui.tbd}</div>
        )}
        <div class="card p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-baseline justify-between border-b border-line/40 pb-3">
              <h3 class="font-heading text-3xl sm:text-4xl font-extrabold text-accent">{c.name}</h3>
              <span class="rounded-[4px] bg-accent/15 px-2.5 py-1 font-heading text-xs font-bold text-accent border border-accent/30">Kategori Resmi</span>
            </div>
            {c.detail && (
              <div class="mt-4 rounded-[4px] bg-alt/60 p-4 border border-line/50">
                <div class="entry text-sm text-dark-ink" set:html={md(c.detail)} />
              </div>
            )}
            {c.routeDetail && (
              <div class="mt-4">
                <h4 class="font-heading text-xs font-bold uppercase tracking-wider text-accent mb-2">Informasi Lintasan</h4>
                <div class="entry text-sm text-dark-ink" set:html={md(c.routeDetail)} />
              </div>
            )}
          </div>
          {registrationUrl && (
            <div class="mt-6 pt-4 border-t border-line/40">
              <a class="btn btn-sm w-full" href={registrationUrl}>Daftar Kategori {c.name}</a>
            </div>
          )}
        </div>
      </div>
    ))
  }

  <dialog class="lightbox lightbox-wide" aria-label="Peta rute ukuran penuh">
    <img alt="" class="max-h-[82vh] w-full object-contain" />
    <form method="dialog" class="mt-3 text-center"><button class="btn btn-blue">{ui.closeLightbox}</button></form>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-route-tabs]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const select = (i: number, focus = true) => {
      btns.forEach((b, j) => {
        b.setAttribute('aria-selected', String(i === j));
        b.tabIndex = i === j ? 0 : -1;
        panels[j].hidden = i !== j;
      });
      if (focus) btns[i].focus();
    };
    btns.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % btns.length);
        if (e.key === 'ArrowLeft') select((i - 1 + btns.length) % btns.length);
      });
    });
    // Buka kategori dari hash, mis. /#rute-10k
    const fromHash = () => {
      const i = btns.findIndex((b) => `#rute-${b.dataset.key}` === location.hash);
      if (i >= 0) select(i, false);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);

    // Zoom peta
    const dlg = root.querySelector('dialog')!;
    const big = dlg.querySelector('img')!;
    root.querySelectorAll<HTMLButtonElement>('.route-map').forEach((m) =>
      m.addEventListener('click', () => {
        big.src = m.dataset.full!;
        big.alt = m.dataset.alt ?? '';
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
