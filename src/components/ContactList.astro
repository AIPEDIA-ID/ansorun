---
import { md, waLink, fmtPhone } from '../lib/text';
import type { ContactInfo } from '../lib/types';

interface Props { contact: ContactInfo }
const { contact } = Astro.props;
---

<div>
  {
    contact.people.length > 0 && (
      <div class="card overflow-x-auto">
        <table class="w-full border-collapse bg-paper text-left text-[0.8rem] sm:text-sm">
          <thead>
            <tr class="bg-primary text-white">
              <th class="px-2.5 py-3 sm:px-4 font-heading font-bold">Nama</th>
              <th class="px-2.5 py-3 sm:px-4 font-heading font-bold">Telepon</th>
              <th class="px-2.5 py-3 sm:px-4 text-right font-heading font-bold">WhatsApp</th>
            </tr>
          </thead>
          <tbody>
            {contact.people.map((p) => (
              <tr class="border-b border-line">
                <td class="px-2.5 py-3 sm:px-4 font-bold text-ink">{p.name}</td>
                <td class="px-2.5 py-3 sm:px-4 whitespace-nowrap"><a class="inline-block py-2" href={`tel:${p.phone.replace(/\D/g, '')}`}>{fmtPhone(p.phone)}</a></td>
                <td class="px-2.5 py-3 sm:px-4 text-right"><a class="btn btn-blue btn-sm !px-3" href={waLink(p.phone)} rel="noopener" target="_blank" aria-label={`WhatsApp ${p.name}`}>Chat</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {contact.note && <div class="entry mt-5 text-center text-sm" set:html={md(contact.note)} />}
  {
    (contact.website || contact.email) && (
      <p class="mt-5 flex flex-wrap justify-center gap-x-8 gap-y-1 text-sm font-semibold">
        {contact.website && <a class="inline-block py-2" href={contact.website} rel="noopener" target="_blank">{contact.website.replace(/^https?:\/\//, '')}</a>}
        {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      </p>
    )
  }
</div>
