---
import Icon from './Icon.astro';
import { md, waLink, fmtPhone } from '../lib/text';
import type { ContactInfo } from '../lib/types';

interface Props { contact: ContactInfo; compact?: boolean }
const { contact, compact = false } = Astro.props;
---

<div class:list={['contact-list', compact && 'is-compact']}>
  {
    contact.people.length > 0 && (
      <ul class:list={['grid gap-3', !compact && 'sm:grid-cols-3']}>
        {contact.people.map((p) => (
          <li class="contact-card flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5">
            <div class="flex items-center gap-3.5 min-w-0">
              <span class="step-icon flex-none"><Icon name="phone" size={20} /></span>
              <div class="min-w-0">
                <p class="font-heading text-base font-bold text-white">{p.name}</p>
                <p class="mt-0.5 text-xs text-dark-ink"><a href={`tel:${p.phone.replace(/\D/g, '')}`}>{fmtPhone(p.phone)}</a></p>
              </div>
            </div>
            <a class="btn btn-blue btn-sm w-full sm:w-auto text-center" href={waLink(p.phone)} rel="noopener" target="_blank" aria-label={`WhatsApp ${p.name}`}>WhatsApp</a>
          </li>
        ))}
      </ul>
    )
  }
  {contact.note && <div class="entry mt-4 text-sm" set:html={md(contact.note)} />}
  {
    (contact.website || contact.email) && (
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
        {contact.website && <a href={contact.website} rel="noopener" target="_blank">{contact.website.replace(/^https?:\/\//, '')}</a>}
        {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      </p>
    )
  }
</div>
