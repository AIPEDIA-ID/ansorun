---
import { md, waLink, fmtPhone } from '../lib/text';
import type { ContactInfo } from '../lib/types';

interface Props { contact: ContactInfo }
const { contact } = Astro.props;
---

<div class="card mx-auto max-w-2xl p-2">
  {
    contact.people.length > 0 && (
      <ul class="divide-y divide-line">
        {contact.people.map((p) => (
          <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3.5">
            <span class="font-heading text-base font-bold text-ink">{p.name}</span>
            <span class="flex items-center gap-4">
              <a class="whitespace-nowrap text-sm" href={`tel:${p.phone.replace(/\D/g, '')}`}>{fmtPhone(p.phone)}</a>
              <a class="btn btn-blue btn-sm" href={waLink(p.phone)} rel="noopener" target="_blank" aria-label={`WhatsApp ${p.name}`}>WhatsApp</a>
            </span>
          </li>
        ))}
      </ul>
    )
  }
  {
    (contact.website || contact.email || contact.note) && (
      <div class="border-t border-line px-4 py-3.5 text-sm">
        {contact.note && <div class="entry mb-2" set:html={md(contact.note)} />}
        <p class="flex flex-wrap gap-x-6 gap-y-1">
          {contact.website && <a href={contact.website} rel="noopener" target="_blank">{contact.website.replace(/^https?:\/\//, '')}</a>}
          {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
        </p>
      </div>
    )
  }
</div>
