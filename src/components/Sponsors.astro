---
import { getSiteData } from '../lib/content';
import { img } from '../lib/datocms';

const { sponsors } = await getSiteData();

// Kelompokkan per role, urutan mengikuti urutan di CMS
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<section class="border-b border-line bg-white py-8">
  <div class="container-x flex flex-wrap items-start justify-center gap-x-14 gap-y-5">
    {
      [...groups].map(([role, list]) => (
        <div class="text-center">
          <div class="mb-2 text-[11px] font-semibold uppercase tracking-[.15em] text-ink-soft">{role}</div>
          <div class="flex items-center justify-center gap-5">
            {list.map((s) => {
              const inner = s.logo
                ? <img src={img(s.logo.url, 240)} alt={s.name} class="h-10 w-auto" loading="lazy" />
                : <span class="font-heading text-base font-bold text-dark">{s.name}</span>;
              return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
            })}
          </div>
        </div>
      ))
    }
  </div>
</section>
