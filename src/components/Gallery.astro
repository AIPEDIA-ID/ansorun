---
import { img as optimize } from '../lib/datocms';
import { ui } from '../config';
import Photo from './Photo.astro';
import type { GalleryPhoto } from '../lib/types';

interface Props { photos: GalleryPhoto[]; dark?: boolean }
const { photos, dark = false } = Astro.props;
---

<div data-gallery>
  <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
    {
      photos.map((p) => (
        <li>
          {p.image ? (
            <a class="thumb" href={optimize(p.image.url, 1600)} data-full={optimize(p.image.url, 1600)} data-caption={p.caption ?? ''}>
              <Photo image={p.image} alt={p.caption ?? ''} width={600} ratio="4/3" />
            </a>
          ) : (
            <Photo image={null} ratio="4/3" label="Foto" dark={dark} class="rounded-[4px]" />
          )}
          {p.caption && <p class:list={['mt-2 text-xs', dark ? 'text-white/60' : 'text-ink-soft']}>{p.caption}</p>}
        </li>
      ))
    }
  </ul>
  <dialog class="lightbox" aria-label="Pratinjau foto">
    <img alt="" class="max-h-[80vh] w-full object-contain" />
    <p class="mt-2 text-center text-xs text-ink-soft" data-cap></p>
    <form method="dialog" class="mt-3 text-center"><button class="btn btn-blue">{ui.closeLightbox}</button></form>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dlg = root.querySelector('dialog')!;
    const big = dlg.querySelector('img')!;
    const cap = dlg.querySelector<HTMLElement>('[data-cap]')!;
    root.querySelectorAll<HTMLAnchorElement>('a[data-full]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        big.src = a.dataset.full!;
        big.alt = a.dataset.caption ?? '';
        cap.textContent = a.dataset.caption ?? '';
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
