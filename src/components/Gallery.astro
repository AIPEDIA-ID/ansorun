---
import { img as optimize } from '../lib/datocms';
import { ui } from '../config';
import Photo from './Photo.astro';
import type { GalleryPhoto } from '../lib/types';

interface Props { photos: GalleryPhoto[]; cols?: string }
const { photos, cols = 'grid-cols-2 sm:grid-cols-3' } = Astro.props;
---

{
  photos.length === 0 ? (
    <p class="entry text-ink-soft">{ui.galleryEmpty}</p>
  ) : (
    <div data-gallery>
      <ul class:list={['grid gap-3', cols]}>
        {
          photos.map((p) => (
            <li>
              <a class="thumb" href={optimize(p.image.url, 1600)} data-full={optimize(p.image.url, 1600)} data-caption={p.caption ?? ''}>
                <Photo image={p.image} alt={p.caption ?? ''} width={500} ratio="4/3" />
              </a>
              {p.caption && <p class="mt-1 text-xs text-ink-soft">{p.caption}</p>}
            </li>
          ))
        }
      </ul>
      <dialog class="lightbox" aria-label="Pratinjau foto">
        <img alt="" class="max-h-[80vh] w-full object-contain" />
        <p class="mt-1 text-center text-xs text-ink-soft" data-cap></p>
        <form method="dialog" class="mt-2 text-center"><button class="btn btn-blue">Tutup</button></form>
      </dialog>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dlg = root.querySelector('dialog')!;
    const big = dlg.querySelector('img')!;
    const cap = dlg.querySelector<HTMLElement>('[data-cap]')!;
    root.querySelectorAll<HTMLAnchorElement>('a[data-full]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        big.src = a.dataset.full!;
        big.alt = a.dataset.caption ?? '';
        cap.textContent = a.dataset.caption ?? '';
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
