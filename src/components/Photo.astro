---
import { img as optimize } from '../lib/datocms';
import type { Img } from '../lib/types';

interface Props {
  image: Img | null | undefined;
  alt?: string;
  width?: number; // lebar maksimum untuk resize imgix
  ratio?: string; // css aspect-ratio, mis. "4/3"
  label?: string; // teks placeholder bila belum ada gambar
  class?: string;
  eager?: boolean;
  dark?: boolean; // placeholder untuk latar gelap
  fit?: 'cover' | 'contain'; // contain = tampilkan utuh (mockup produk)
}
const { image, alt = '', width = 800, ratio = '4/3', label = '', class: cls = '', eager = false, dark = false, fit = 'cover' } = Astro.props;
const [rw, rh] = ratio.split('/').map(Number);
// Dimensi selalu diisi (dari CMS, atau dari rasio) agar layout tidak bergeser saat gambar dimuat
const w = image?.width ?? width;
const h = image?.height ?? Math.round(width * (rh / rw));
---

{
  image ? (
    <img
      src={optimize(image.url, width)}
      alt={alt || image.alt || ''}
      width={w}
      height={h}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['block w-full', fit === 'contain' ? 'object-contain' : 'object-cover', cls]}
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <div
      role="img"
      aria-label={alt || label || 'Foto'}
      class:list={[
        'flex w-full items-center justify-center font-heading text-xs font-bold uppercase tracking-[.2em]',
        dark ? 'bg-white/5 text-white/40' : 'bg-tint text-ink-soft',
        cls,
      ]}
      style={`aspect-ratio:${ratio}`}
    >
      {label}
    </div>
  )
}
