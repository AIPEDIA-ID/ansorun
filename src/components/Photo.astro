---
import { img as optimize } from '../lib/datocms';
import type { Img } from '../lib/types';

interface Props {
  image: Img | null | undefined;
  alt?: string;
  width?: number; // lebar maksimum untuk resize imgix
  ratio?: string; // css aspect-ratio, mis. "4/3"
  label?: string; // teks placeholder bila belum ada gambar
  class?: string;
  eager?: boolean;
  dark?: boolean; // placeholder untuk latar gelap
}
const { image, alt = '', width = 800, ratio = '4/3', label = '', class: cls = '', eager = false, dark = false } = Astro.props;
---

{
  image ? (
    <img
      src={optimize(image.url, width)}
      alt={alt || image.alt || ''}
      width={image.width ?? undefined}
      height={image.height ?? undefined}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['block w-full object-cover', cls]}
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <div
      role="img"
      aria-label={alt || label || 'Foto'}
      class:list={[
        'flex w-full items-center justify-center font-heading text-xs font-bold uppercase tracking-[.2em]',
        dark ? 'bg-white/5 text-white/40' : 'bg-tint text-ink-soft',
        cls,
      ]}
      style={`aspect-ratio:${ratio}`}
    >
      {label}
    </div>
  )
}
