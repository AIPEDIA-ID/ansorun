---
import { ui } from '../config';
import { cmsAttr } from '../lib/cms';
import { rich } from '../lib/text';

interface Props { target: string; title?: string; text?: string; embedded?: boolean }
const { target, title = '', text = '', embedded = false } = Astro.props;
const units = [
  ['days', ui.units.days],
  ['hours', ui.units.hours],
  ['minutes', ui.units.minutes],
  ['seconds', ui.units.seconds],
] as const;
---

<section class:list={[embedded ? 'hero-countdown' : 'section']} data-countdown={target} {...cmsAttr('data-countdown', 'eventDate', 'Start date & time (ISO)')}>
  <div class="container-x">
    {
      (title || text) && (
        <div class="mb-14 max-w-3xl">
          {title && <h2 class="rich text-[clamp(28px,4.5vw,46px)] font-semibold text-primary" set:html={rich(title)} />}
          {text && <p class="mt-3 text-ink-soft">{text}</p>}
        </div>
      )
    }
    <div class="grid grid-cols-4 gap-2 text-center sm:gap-6" data-countdown-grid>
      {
        units.map(([key, label]) => (
          <div>
            <div class="count-num" data-unit={key}>00</div>
            <div class="count-label" data-cms-skip>{label}</div>
          </div>
        ))
      }
    </div>
    <p class:list={["hidden text-center font-heading text-xl font-bold", embedded ? "text-white" : "text-primary"]} data-countdown-done data-cms-skip>{ui.countdownDone}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    const target = new Date(root.dataset.countdown!).getTime();
    const grid = root.querySelector<HTMLElement>('[data-countdown-grid]')!;
    const done = root.querySelector<HTMLElement>('[data-countdown-done]')!;
    const el = (u: string) => root.querySelector<HTMLElement>(`[data-unit="${u}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        grid.classList.add('hidden');
        done.classList.remove('hidden');
        return false;
      }
      const s = Math.floor(diff / 1000);
      el('days').textContent = pad(Math.floor(s / 86400));
      el('hours').textContent = pad(Math.floor((s % 86400) / 3600));
      el('minutes').textContent = pad(Math.floor((s % 3600) / 60));
      el('seconds').textContent = pad(s % 60);
      return true;
    };
    if (tick()) {
      const id = setInterval(() => { if (!tick()) clearInterval(id); }, 1000);
    }
  });
</script>
