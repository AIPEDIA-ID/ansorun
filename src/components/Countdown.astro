---
import { ui } from '../config';

interface Props { target: string }
const { target } = Astro.props;
const units = [
  ['days', ui.units.days],
  ['hours', ui.units.hours],
  ['minutes', ui.units.minutes],
  ['seconds', ui.units.seconds],
] as const;
---

<div data-countdown={target}>
  <div class="grid max-w-xl grid-cols-4 gap-x-4 text-left sm:gap-x-8" data-countdown-grid>
    {
      units.map(([key, label]) => (
        <div>
          <div class="count-num" data-unit={key}>--</div>
          <div class="count-label">{label}</div>
        </div>
      ))
    }
  </div>
  <p class="hidden font-heading text-lg font-bold" data-countdown-done>{ui.countdownDone}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    const target = new Date(root.dataset.countdown!).getTime();
    const grid = root.querySelector<HTMLElement>('[data-countdown-grid]')!;
    const done = root.querySelector<HTMLElement>('[data-countdown-done]')!;
    const el = (u: string) => root.querySelector<HTMLElement>(`[data-unit="${u}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        grid.classList.add('hidden');
        done.classList.remove('hidden');
        return false;
      }
      const s = Math.floor(diff / 1000);
      el('days').textContent = pad(Math.floor(s / 86400));
      el('hours').textContent = pad(Math.floor((s % 86400) / 3600));
      el('minutes').textContent = pad(Math.floor((s % 3600) / 60));
      el('seconds').textContent = pad(s % 60);
      return true;
    };
    if (tick()) {
      const id = setInterval(() => { if (!tick()) clearInterval(id); }, 1000);
    }
  });
</script>
