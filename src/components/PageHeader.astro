---
interface Props { title: string; crumb?: string; subtitle?: string }
const { title, crumb = title, subtitle } = Astro.props;
---

<section class="page-banner">
  <div class="container-x flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1>{title}</h1>
      {subtitle && <p class="mt-2 max-w-2xl text-white/80">{subtitle}</p>}
    </div>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Beranda</a> &nbsp;/&nbsp; <span>{crumb}</span>
    </nav>
  </div>
</section>
