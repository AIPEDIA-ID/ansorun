---
import '../styles/theme.css';
import { getSiteData } from '../lib/content';
import { img } from '../lib/datocms';
import { plain } from '../lib/text';
import { fonts, fontFaceCss, nav, ui } from '../config';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string }
const { title, description } = Astro.props;

const { site, footerLinks } = await getSiteData();
const pageTitle = title ? `${title} — ${site.eventName}` : `${site.eventName} | ${site.tagline}`;
const metaDesc = plain(description ?? site.metaDescription);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = site.heroImage ? img(site.heroImage.url, 1200) : new URL('/brand/og.jpg', Astro.site).href;

// Structured data Event (Google rich result) — hanya di Beranda
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: plain(site.eventName),
  description: metaDesc,
  startDate: site.eventDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: site.location, address: site.location },
  url: canonical,
  ...(ogImage && { image: [ogImage] }),
  ...(site.registrationUrl && {
    offers: { '@type': 'Offer', url: site.registrationUrl, availability: 'https://schema.org/InStock' },
  }),
};

// Override warna dari DatoCMS (opsional) — mengalahkan token di theme.css
const overrides = [
  `--t-font-heading:${fonts.heading}`,
  `--t-font-body:${fonts.body}`,
  `--t-font-tag:${fonts.tag}`,
  `--t-font-display:${fonts.display}`,
  site.primaryColor && `--t-primary:${site.primaryColor}`,
  site.accentColor && `--t-accent:${site.accentColor}`,
].filter(Boolean).join(';');

const groups = new Map<string, typeof footerLinks>();
for (const l of footerLinks) groups.set(l.group, [...(groups.get(l.group) ?? []), l]);

const socials = ([
  ['Instagram', 'instagram', site.instagramUrl],
  ['TikTok', 'tiktok', site.tiktokUrl],
  ['Facebook', 'facebook', site.facebookUrl],
  ['X', 'x', site.xUrl],
  ['Threads', 'threads', site.threadsUrl],
] as const).filter(([, , url]) => url);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts.href} rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={plain(site.eventName)} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />}
    {<style set:html={`${fontFaceCss}:root{${overrides}}`} />}
  </head>
  <body id="top">
    <!-- Header: transparan di atas hero, solid putih setelah scroll -->
    <header class="header" data-header>
      <div class="container-x flex flex-wrap items-center justify-between gap-x-6" style="min-height:var(--t-header-h)">
        <a href="/" class="site-title" aria-label={plain(site.eventName)}>
          {
            site.logo ? (
              <img src={img(site.logo.url, 400)} alt={plain(site.eventName)} class="logo-cms h-11 w-auto" />
            ) : (
              <>
                <img src="/brand/logo-light.webp" alt={plain(site.eventName)} width="1600" height="440" class="logo-on-clear h-12 w-auto sm:h-14" />
                <img src="/brand/logo-dark.webp" alt="" width="1600" height="440" class="logo-on-solid h-12 w-auto sm:h-14" />
              </>
            )
          }
        </a>
        <nav class="nav" aria-label="Menu utama">
          <ul class="flex flex-wrap">
            {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container-x grid gap-12 py-16 lg:grid-cols-[1.3fr_2fr]">
        <div>
          <img src="/brand/logo-light.webp" alt={plain(site.eventName)} width="1600" height="440" class="h-16 w-auto" loading="lazy" />
          <p class="mt-3 max-w-xs">{site.tagline}</p>
          <p class="mt-1">{site.categories}</p>
          <p class="mt-3 flex items-center gap-2"><Icon name="pin" size={16} /> {site.location}</p>
          <ul class="mt-5 flex gap-2">
            {socials.map(([label, icon, url]) => (
              <li><a class="social-btn" href={url!} aria-label={label} rel="noopener" target={url!.startsWith('http') ? '_blank' : undefined}><Icon name={icon} size={18} /></a></li>
            ))}
          </ul>
        </div>
        <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
          {
            [...groups].map(([group, links]) => (
              <div>
                <h4>{group}</h4>
                <ul class="space-y-2.5">{links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="container-x border-t border-white/10 py-6 text-[13px]">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span>{site.footerNote}</span>
          <a href="#top">{ui.backToTop} &uarr;</a>
        </div>
      </div>
      <div class="footer-rule"></div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
