---
import '../styles/theme.css';
import { getSiteData, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { nav, ui } from '../config';
import SocialLinks from '../components/SocialLinks.astro';

interface Props { title?: string; description?: string }
const { title, description } = Astro.props;

const { site, footerLinks } = await getSiteData();
const pageTitle = title ? `${title} — ${site.eventName}` : `${site.eventName} — ${site.tagline}`;
const metaDesc = description ?? site.heroSubheadline;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Override warna dari DatoCMS (opsional) — mengalahkan token di theme.css
const overrides = [
  site.primaryColor && `--t-primary:${site.primaryColor}`,
  site.accentColor && `--t-accent:${site.accentColor}`,
].filter(Boolean).join(';');

const groups = new Map<string, typeof footerLinks>();
for (const l of footerLinks) groups.set(l.group, [...(groups.get(l.group) ?? []), l]);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    {site.heroImage && <meta property="og:image" content={img(site.heroImage.url, 1200)} />}
    {overrides && <style set:html={`:root{${overrides}}`} />}
  </head>
  <body id="top">
    <div class="topbar">
      <div class="container-x flex flex-wrap items-center justify-between gap-2 py-2">
        <span>{formatDate(site.eventDate, { dateStyle: 'full' })} &middot; {site.location}</span>
        <SocialLinks />
      </div>
    </div>

    <header class="header">
      <div class="container-x flex flex-wrap items-center justify-between gap-x-6" style="min-height:var(--t-header-h)">
        <a href="/" class="site-title" aria-label={site.eventName}>
          {site.logo ? <img src={img(site.logo.url, 400)} alt={site.eventName} class="h-11 w-auto" /> : site.eventName}
        </a>
        <nav class="nav" aria-label="Menu utama">
          <ul class="flex flex-wrap">
            {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container-x grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <h4>{site.eventName}</h4>
          <p>{site.tagline}</p>
          <p class="mt-3">{site.categories}</p>
          <p>{site.location}</p>
        </div>
        {
          [...groups].map(([group, links]) => (
            <div>
              <h4>{group}</h4>
              <ul class="space-y-2">{links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
            </div>
          ))
        }
      </div>
      <div class="site-footer-bottom">
        <div class="container-x flex flex-wrap items-center justify-between gap-2 py-4">
          <span>{site.footerNote}</span>
          <a href="#top">{ui.backToTop}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
