---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Gallery from '../components/Gallery.astro';
import Sidebar from '../components/Sidebar.astro';
import { getGallery } from '../lib/content';
import { ui } from '../config';

const photos = await getGallery();
---

<Base title={ui.galleryTitle}>
  <PageHeader title={ui.galleryTitle} subtitle="Sorotan dan suasana event dalam satu galeri." />
  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_300px]">
    <Gallery photos={photos} cols="grid-cols-2 sm:grid-cols-3" />
    <Sidebar />
  </div>
</Base>
