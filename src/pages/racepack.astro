---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MatteImage from '../components/MatteImage.astro';
import ContactList from '../components/ContactList.astro';
import { getRacepack, getHome, getContact } from '../lib/content';
import { md } from '../lib/text';
import { ui } from '../config';
import { racepackPhoto } from '../lib/fallback';

const { page, steps } = await getRacepack();
const contact = await getContact();
const { items } = await getHome();

// Emoji penanda item (pola digiland); item di luar daftar ini memakai 🎁
const emoji: Record<string, string> = {
  'Kaos Lari': '👕', Medali: '🏅', 'Nomor Dada': '🎽', 'Tas Serut': '🎒', 'Air Minum': '💧',
  Roti: '🍞', Multivitamin: '💊', 'Kartu E-Money': '💳', 'Kalender Puasa': '📅',
};
---

<Base title="Racepack" description={page.metaDescription}>
  <PageBanner crumb="Racepack" title={page.bannerTitle} tagline="" image={page.heroImage?.url} />

  <!-- 1. Racepack Collection (pola digiland.co.id/run): judul, info pengambilan, daftar item + panel preview -->
  <section class="section bg-fade" id="langkah">
    <div class="container-x">
      <SectionHeading title={page.title} />
      <div class="panel" data-picker>
        <dl class="meta-row">
          {
            [
              { icon: 'pin', label: 'Lokasi pengambilan', text: page.venue },
              { icon: 'calendar', label: 'Tanggal pengambilan', text: page.date },
              { icon: 'clock', label: 'Jam operasional', text: page.hours },
            ].map((m) => (
              <div class="meta-item">
                <span class="step-icon"><Icon name={m.icon} size={20} /></span>
                <div>
                  <dt>{m.label}</dt>
                  <dd class:list={[m.text === ui.tbd && 'tbd']}>{m.text}</dd>
                </div>
              </div>
            ))
          }
        </dl>
        <div class="grid items-start gap-6 lg:grid-cols-[1fr_1fr]">
          <div class="pick-wrap">
            <div class="pick-list" role="tablist" aria-label={ui.racepackSub}>
              <button type="button" class="pick-item" role="tab" aria-selected="true" data-src={racepackPhoto.url} data-alt={racepackPhoto.alt ?? ''} data-desc="">
                <strong><span class="pick-emoji" aria-hidden="true">🎁</span><span class="pick-name">{ui.racepackSub}</span></strong>
              </button>
              {
                items.map((it) => (
                  <button type="button" class="pick-item" role="tab" aria-selected="false" data-src={(it.image ?? racepackPhoto).url} data-alt={(it.image ?? racepackPhoto).alt ?? it.title} data-desc={it.description === ui.tbd ? '' : it.description} data-soon={it.image ? undefined : ''} data-icon={emoji[it.title] ?? '🎁'}>
                    <strong><span class="pick-emoji" aria-hidden="true">{emoji[it.title] ?? '🎁'}</span><span class="pick-name">{it.title}</span>{!it.image && <em class="pick-tag">Coming soon</em>}</strong>
                  </button>
                ))
              }
            </div>
            <p class="pick-scroll-hint" data-scroll-hint aria-hidden="true">
              Scroll untuk melihat semua item
            </p>
          </div>
          <div class="photo-matte pick-preview">
            <img src={racepackPhoto.url} alt={racepackPhoto.alt ?? ''} width={racepackPhoto.width ?? 1578} height={racepackPhoto.height ?? 997} data-preview />
            <div class="pick-soon" data-soon-panel hidden>
              <span aria-hidden="true" data-soon-icon>🎁</span>
              <strong>Coming soon</strong>
            </div>
            <p class="pick-desc" data-desc aria-live="polite"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Cara pengambilan: 3 langkah + dokumen + pengambilan diwakilkan, satu grid (pola digiland) -->
  <section class="section bg-pattern" id="info">
    <div class="container-x">
      <SectionHeading title="CARA **PENGAMBILAN**"><p>{page.venue} · {page.date}</p></SectionHeading>
      <ol class="grid gap-6 lg:grid-cols-6 on-dark">
        {
          steps.map((s, i) => (
            <li class="card-dark relative p-7 lg:col-span-2">
              <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-icon"><Icon name={s.icon ?? 'star'} size={26} /></span>
              <h3 class="mt-5 text-lg">{s.title}</h3>
              <div class="entry mt-2 text-sm" set:html={md(s.description)} />
            </li>
          ))
        }
      </ol>
      <div class="mt-6 grid gap-6 md:grid-cols-2" id="persiapan">
        <div class="info-card">
          <span class="step-icon"><Icon name="id" size={22} /></span>
          <div>
            <h3>Dokumen yang harus dibawa</h3>
            <div class="entry mt-1 text-sm" set:html={md(page.documents)} />
          </div>
        </div>
        <div class="info-card" id="perwakilan">
          <span class="step-icon"><Icon name="file" size={22} /></span>
          <div>
            <h3>Pengambilan diwakilkan</h3>
            <div class="entry mt-1 text-sm" set:html={md(page.proxyNote)} />
            {
              page.proxyFileUrl && (
                <p class="mt-4"><a class="btn btn-blue btn-sm" href={page.proxyFileUrl} download><Icon name="download" size={16} /> {page.proxyFileLabel}</a></p>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Informasi kontak panitia (proposal hal. 27) -->
  <section class="section bg-fade" id="kontak">
    <div class="container-x max-w-3xl">
      <SectionHeading title="KONTAK **PANITIA**" />
      <ContactList contact={contact} />
    </div>
  </section>
</Base>

<script>
  // Daftar item: klik mengganti foto preview dan keterangannya
  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    const img = root.querySelector<HTMLImageElement>('[data-preview]');
    const desc = root.querySelector<HTMLElement>('[data-desc]:not(button)');
    const soon = root.querySelector<HTMLElement>('[data-soon-panel]');
    const soonIcon = root.querySelector<HTMLElement>('[data-soon-icon]');
    const list = root.querySelector<HTMLElement>('.pick-list');
    const hint = root.querySelector<HTMLElement>('[data-scroll-hint]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.pick-item')];

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        t.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const isSoon = t.dataset.soon !== undefined;
        if (img && soon) {
          img.hidden = isSoon;
          soon.hidden = !isSoon;
          if (soonIcon) soonIcon.textContent = t.dataset.icon ?? '🎁';
        }
        if (!isSoon && img && t.dataset.src && !img.src.endsWith(t.dataset.src)) {
          img.classList.add('is-swapping');
          setTimeout(() => {
            img.src = t.dataset.src ?? img.src;
            img.alt = t.dataset.alt ?? '';
            img.classList.remove('is-swapping');
          }, 120);
        }
        if (desc) desc.textContent = t.dataset.desc ?? '';
      }),
    );


    // Petunjuk hilang setelah daftar digulir
    list?.addEventListener('scroll', () => hint?.classList.toggle('is-hidden', list.scrollTop > 16), { passive: true });
  });
</script>
