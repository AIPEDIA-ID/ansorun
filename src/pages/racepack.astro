---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import RacepackViewer from '../components/RacepackViewer.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import ContactList from '../components/ContactList.astro';
import { getSiteData, getHome, getRacepack, getContacts } from '../lib/content';
import { md, rich } from '../lib/text';
import { ui } from '../config';

const { site } = await getSiteData();
const { home } = await getHome();
const { page, info, steps, items } = await getRacepack();
const contacts = await getContacts();

// Susun kartu info agar baris selalu penuh (3 per baris; sisa 2 atau 1 dilebarkan)
const rest = info.length % 3;
const spanFor = (i: number) => (i < info.length - rest ? 'lg:col-span-2' : rest === 2 ? 'lg:col-span-3' : rest === 1 ? 'lg:col-span-6' : 'lg:col-span-2');
---

<Base title="Racepack" description={page.metaDescription}>
  <PageBanner crumb="Racepack" title={page.title} tagline={page.slogan} subtitle="" image={page.bannerImage} />

  <!-- Informasi pengambilan -->
  <div class="dark-flow on-dark">
  <section class="section on-dark" id="info">
    <div class="container-x">
      <h2 class="sr-only">{ui.racepackInfoHeading}</h2>
      <div class="section-heading">
        <p>{page.intro}</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
        {
          info.map((i, idx) => (
            <li class:list={['card card-accent flex gap-4 p-6', spanFor(idx)]}>
              <span class="icon-chip"><Icon name={i.icon ?? 'info'} size={22} /></span>
              <div>
                <h3 class="text-base">{i.title}</h3>
                <div class="entry mt-1 text-sm text-dark-ink" set:html={md(i.content)} />
              </div>
            </li>
          ))
        }
        <li class="card card-accent p-6 sm:col-span-2 lg:col-span-6">
          <h3 class="text-base">{ui.contactHeading}</h3>
          <div class="mt-4"><ContactList contacts={contacts} columns /></div>
        </li>
      </ul>
      {
        page.proxyFileUrl && (
          <p class="mt-8 text-center"><a class="btn btn-primary" href={page.proxyFileUrl} download><Icon name="download" size={16} /> {page.proxyFileLabel}</a></p>
        )
      }
    </div>
  </section>

  <!-- Tiga langkah visual -->
  <section class="section on-dark" id="langkah">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent font-light" set:html={rich(page.stepsTitle)} />
      </div>
      <ol class="grid gap-5 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="card-dark card-accent relative p-8">
              <span class="num absolute right-6 top-6 text-5xl">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon-chip icon-chip-lg"><Icon name={s.icon ?? 'star'} size={28} /></span>
              <h3 class="mt-6 text-lg">{s.title}</h3>
              <p class="mt-2 text-sm text-white/70">{s.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Isi race pack -->
  <section class="section on-dark" id="isi">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent font-light" set:html={rich(page.itemsTitle)} />
        <p>{page.itemsText}</p>
      </div>
      <RacepackViewer items={items} fallbackImage={home.racepackImage} />
    </div>
  </section>

  <Newsletter action={site.newsletterAction} />
  </div>
</Base>
