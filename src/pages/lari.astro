---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Tabs from '../components/Tabs.astro';
import Sidebar from '../components/Sidebar.astro';
import { getLari, md } from '../lib/content';

const { lari, items, steps, tabs } = await getLari();
---

<Base title="Lari">
  <PageHeader title="Lari" subtitle={lari.racepackIntro} />
  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_300px]">
    <div>
      <!-- Racepack -->
      <section>
        <h2 class="section-title" id="racepack">Race Pack Collection</h2>
        <div class="widget">
          <h3 class="widget-title">{lari.racepackVenue}</h3>
          <div class="widget-body entry" set:html={md(lari.racepackSchedule)} />
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            items.map((it) => (
              <li class="card card-top">
                <Photo image={it.image} alt={it.title} width={500} ratio="16/9" label={it.title} />
                <div class="widget-body">
                  <h3 class="text-base">{it.title}</h3>
                  <p class="mt-1 text-sm">{it.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Langkah pengambilan -->
      <section>
        <h2 class="section-title">{lari.stepsTitle}</h2>
        <ol class="space-y-6">
          {
            steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent font-heading font-bold text-white">{i + 1}</span>
                <div class="grid flex-1 items-start gap-4 sm:grid-cols-[200px_1fr]">
                  {s.image && <Photo image={s.image} alt={`Langkah ${i + 1}`} width={400} ratio="4/3" class="thumb" />}
                  <p class:list={[!s.image && 'sm:col-span-2']}>{s.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="widget mt-8">
          <h3 class="widget-title">Catatan: Diwakilkan</h3>
          <div class="widget-body">
            <div class="entry" set:html={md(lari.proxyNote)} />
            {lari.proxyFileUrl && <p class="mt-3"><a class="btn" href={lari.proxyFileUrl} download>{lari.proxyFileLabel}</a></p>}
          </div>
        </div>
      </section>

      <!-- Komunitas -->
      <section id="komunitas">
        <h2 class="section-title">{lari.communityTitle}</h2>
        <div class="grid gap-4 sm:grid-cols-[200px_1fr]">
          <Photo image={lari.communityImage} alt={lari.communityTitle} width={500} ratio="4/3" label="Komunitas" class="thumb" />
          <div>
            <p>{lari.communityText}</p>
            {lari.communityUrl && <p class="mt-3"><a class="btn btn-blue" href={lari.communityUrl}>Ikuti di Instagram</a></p>}
          </div>
        </div>
      </section>

      <!-- Info -->
      <section id="info">
        <h2 class="section-title">{lari.infoTitle}</h2>
        <Tabs tabs={tabs} />
      </section>
    </div>
    <Sidebar />
  </div>
</Base>
