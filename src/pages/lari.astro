---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import RacepackViewer from '../components/RacepackViewer.astro';
import Photo from '../components/Photo.astro';
import Tabs from '../components/Tabs.astro';
import Icon from '../components/Icon.astro';
import { getLari } from '../lib/content';
import { img } from '../lib/datocms';
import { md, rich } from '../lib/text';
import { ui } from '../config';

const { lari, items, steps, tabs } = await getLari();
const communityBg = lari.communityImage ? `background-image:url(${img(lari.communityImage.url, 1920)})` : '';
---

<Base title="Lari" description={lari.metaDescription}>
  <PageBanner crumb="Lari" />

  <!-- Racepack + langkah pengambilan (section gelap) -->
  <section class="section bg-dark-section on-dark" id="racepack">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(lari.racepackTitle)} />
        <p>{lari.racepackIntro}</p>
      </div>

      <RacepackViewer venue={lari.racepackVenue} schedule={lari.racepackSchedule} items={items} />

      <div class="card-dark mt-8 p-6 md:p-8">
        <h3 class="text-xl text-white">{lari.stepsTitle}</h3>
        <p class="mt-1 text-sm text-white/60">{lari.stepsText}</p>
        <ol class="mt-6 grid gap-6 md:grid-cols-3">
          {
            steps.map((s, i) => (
              <li>
                <Photo image={s.image} alt={`Langkah ${i + 1}`} width={500} ratio="4/3" dark label={`Langkah ${i + 1}`} class="rounded-[4px]" />
                <div class="mt-3 flex gap-3">
                  <span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-accent font-heading text-sm font-bold text-on-accent">{i + 1}</span>
                  <p class="text-sm text-white/80">{s.description}</p>
                </div>
              </li>
            ))
          }
          <li class="rounded-[4px] bg-white/10 p-6">
            <span class="mb-3 grid h-9 w-9 place-items-center rounded-full bg-white text-dark"><Icon name="info" size={20} /></span>
            <p class="font-heading text-sm font-bold text-white">{ui.stepsNoticeTitle}</p>
            <div class="entry mt-2 text-sm" set:html={md(lari.proxyNote)} />
            {
              lari.proxyFileUrl && (
                <p class="mt-4"><a class="btn" href={lari.proxyFileUrl} download><Icon name="download" size={16} /> {lari.proxyFileLabel}</a></p>
              )
            }
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Komunitas -->
  <section class="relative bg-dark bg-cover bg-center py-28 text-center on-dark" id="komunitas" style={communityBg}>
    <div class="absolute inset-0 bg-dark/70" aria-hidden="true"></div>
    <div class="container-x relative max-w-3xl">
      <h2 class="rich rich-accent text-[clamp(30px,5vw,48px)] font-semibold" set:html={rich(lari.communityTitle)} />
      <p class="mt-4 text-white/85">{lari.communityText}</p>
      {
        lari.communityUrl && (
          <p class="mt-7"><a class="btn" href={lari.communityUrl} rel="noopener" target="_blank"><Icon name="instagram" size={18} /> {ui.followInstagram}</a></p>
        )
      }
    </div>
  </section>

  <!-- Informasi event -->
  <section class="section" id="info">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent text-primary" set:html={rich(lari.infoTitle)} />
        <p>{lari.infoText}</p>
      </div>
      <Tabs tabs={tabs} />
    </div>
  </section>
</Base>
