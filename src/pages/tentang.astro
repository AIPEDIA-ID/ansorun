---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSiteData, getAbout, md } from '../lib/content';
import { ui } from '../config';

const { site } = await getSiteData();
const { about, faqs } = await getAbout();
---

<Base title={about.title}>
  <PageHeader title={about.title} />
  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_300px]">
    <article>
      <div class="entry"><blockquote>{about.quote}</blockquote></div>
      <div class="entry mt-6" set:html={md(about.body)} />

      <h2 class="section-title" id="faq">{ui.faqTitle}</h2>
      {
        faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.question}</summary>
            <div class="entry" set:html={md(f.answer)} />
          </details>
        ))
      }
      {
        site.contactUrl && (
          <p class="mt-8">
            <span class="mr-3 text-ink-soft">{ui.faqContact}</span>
            <a class="btn btn-blue" href={site.contactUrl}>{ui.contactButton}</a>
          </p>
        )
      }
    </article>
    <Sidebar />
  </div>
</Base>
