---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { getSiteData, getAbout } from '../lib/content';
import { md, rich, plain } from '../lib/text';
import { ui } from '../config';

const { site } = await getSiteData();
const { about, faqs } = await getAbout();
---

<Base title="Tentang" description={about.metaDescription}>
  <PageBanner crumb="Tentang" />

  <!-- Tentang -->
  <section class="section">
    <div class="container-x grid gap-12 md:grid-cols-[1fr_1.5fr]">
      <div>
        <h2 class="rich rich-accent text-[clamp(34px,5vw,52px)] font-light leading-[1.05] text-primary" set:html={rich(about.sectionTitle)} />
        <div class="my-6 h-[3px] w-16 bg-accent"></div>
        <p class="font-light italic text-ink-soft">&ldquo;{about.quote}&rdquo;</p>
      </div>
      <div>
        <p class="font-heading text-sm font-extrabold uppercase text-dark">{about.eyebrow}</p>
        <div class="entry mt-5" set:html={md(about.body)} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt bg-alt" id="faq">
    <div class="container-x max-w-3xl">
      <div class="section-heading">
        <h2 class="rich rich-accent text-primary" set:html={rich(about.faqTitle)} />
        <p>{about.faqText}</p>
      </div>
      {
        faqs.map((f, i) => (
          <details class="faq" name="faq">
            <summary>{f.question}</summary>
            <div class="entry" set:html={md(f.answer)} />
          </details>
        ))
      }
      {
        site.contactUrl && (
          <p class="mt-12 text-center">
            <span class="mb-3 block text-ink-soft">{ui.faqContact}</span>
            <a class="btn btn-primary" href={site.contactUrl}>{ui.contactButton}</a>
          </p>
        )
      }
    </div>
  </section>
</Base>
