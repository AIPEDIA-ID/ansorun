---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import Gallery from '../components/Gallery.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { getSiteData, getGallery, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { rich } from '../lib/text';
import { ui } from '../config';

const { site, sponsors } = await getSiteData();
const photos = await getGallery(6);
const hasRealPhotos = photos.some((p) => p.image);

const heroBg = site.heroImage ? `background-image:url(${img(site.heroImage.url, 1920)})` : '';
const igBg = site.instagramImage ? `background-image:url(${img(site.instagramImage.url, 1920)})` : '';

// Kelompokkan sponsor per peran, urutan mengikuti CMS
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<Base>
  <!-- 1. Hero -->
  <section class="hero on-dark" style={heroBg}>
    <div class="container-x flex flex-1 flex-col justify-center py-16">
      <p class="hero-eyebrow">{site.heroEyebrow}</p>
      <h1 class="rich mt-3 max-w-3xl" set:html={rich(site.heroHeadline)} />
      <p class="mt-5 max-w-xl text-lg text-white/90">{site.heroSubheadline}</p>
      <p class="mt-3 font-heading text-sm font-bold">
        {site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-outline" href="/lari">{ui.explore}</a>
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
      </p>
    </div>

    <div class="container-x pb-14">
      <div class="flex flex-wrap items-end gap-x-10 gap-y-4">
        {
          [...groups].map(([role, list]) => (
            <div>
              <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60">{role}</div>
              <div class="flex items-center gap-4">
                {list.map((s) => {
                  const inner = s.logo
                    ? <img src={img(s.logo.url, 240)} alt={s.name} class="h-8 w-auto" loading="lazy" />
                    : <span class="font-heading text-sm font-bold">{s.name}</span>;
                  return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="stripe-band" aria-hidden="true"></div>
  </section>

  <!-- 2. Countdown -->
  <Countdown target={site.eventDate} title={site.countdownTitle} text={site.countdownText} />

  <!-- 3. CTA Instagram -->
  <section class="relative overflow-hidden bg-dark bg-cover bg-center py-28 text-center on-dark" style={igBg}>
    <div class="absolute inset-0 bg-dark/70" aria-hidden="true"></div>
    <div class="container-x relative">
      <h2 class="rich rich-accent text-[clamp(30px,5vw,52px)] font-semibold" set:html={rich(site.instagramTitle)} />
      <p class="mt-4 text-white/85">{site.instagramText}</p>
      <p class="mt-1 font-heading text-sm font-bold text-highlight">{site.instagramHandle}</p>
      {
        site.instagramUrl && (
          <p class="mt-7">
            <a class="btn" href={site.instagramUrl} rel="noopener" target="_blank"><Icon name="instagram" size={18} /> {ui.followInstagram}</a>
          </p>
        )
      }
    </div>
  </section>

  <!-- 4. Galeri -->
  <section class="section bg-dark-section on-dark">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">{ui.galleryEyebrow}</p>
        <h2 class="rich rich-accent" set:html={rich(site.galleryTitle)} />
        <p>{site.galleryText}</p>
      </div>
      <Gallery photos={photos} dark />
      {hasRealPhotos && <p class="mt-12 text-center"><a class="btn btn-outline" href="/galeri">{ui.viewAllPhotos}</a></p>}
    </div>
  </section>

  <!-- 5. Newsletter -->
  <Newsletter action={site.newsletterAction} />
</Base>
