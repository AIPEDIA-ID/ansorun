---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Tabs from '../components/Tabs.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import ContactList from '../components/ContactList.astro';
import { getSiteData, getHome, getFaqs, getContacts, getRacepackItems, getRacepack, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { md, rich } from '../lib/text';
import { ui } from '../config';
import { isLive } from '../lib/pages.mjs';

const { site, sponsors } = await getSiteData();
const { home, aboutSteps, beneficiaries, facts, rundown, routes, prizes, joinSteps } = await getHome();
const [faqs, contacts, racepackItems, racepack] = await Promise.all([getFaqs(), getContacts(), getRacepackItems(), getRacepack()]);

const heroBg = site.heroImage ? `background-image:url(${img(site.heroImage.url, 1920)})` : '';

// Rute lari -> isi tab (gambar + keterangan, markdown)
const routeTabs = routes.map((r) => ({
  title: r.title,
  content: `${r.image ? `<a class="route-map" href="${img(r.image.url, 2400)}" target="_blank" rel="noopener"><img src="${img(r.image.url, 1400)}" alt="${(r.image.alt ?? r.title).replace(/"/g, '&quot;')}" loading="lazy"></a>\n<p class="route-map-hint">${ui.mapZoom}</p>\n\n` : ''}${r.description}`,
}));

// Sponsor dikelompokkan per peran, urutan mengikuti CMS
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<Base>
  <!-- 01. Hero: KV, headline, countdown, CTA -->
  <section class="hero on-dark" style={heroBg}>
    <div class="container-x flex flex-1 flex-col justify-center py-14">
      <p class="hero-eyebrow">{site.heroEyebrow}</p>
      <h1 class="rich mt-3 max-w-3xl" set:html={rich(site.heroHeadline)} />
      <p class="mt-5 max-w-xl text-lg text-white/90">{site.heroSubheadline}</p>
      <p class="mt-3 font-heading text-sm font-bold">
        {site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
        <a class="btn btn-outline" href="#about">{ui.explore}</a>
      </p>
    </div>
    <div class="container-x pb-14">
      <Countdown target={site.eventDate} />
    </div>
    <div class="stripe-band" aria-hidden="true"></div>
  </section>

  <!-- 02. About ANSORUN: tentang event dan misi sosial -->
  <!-- 02. Tentang & konsep sosial (gaya slide 4 PDF) -->
  <section class="section" id="about">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">{ui.eyebrows.about}</p>
        <h2 class="rich rich-accent title-italic mt-3 text-[clamp(30px,4.2vw,46px)] font-light leading-[1.1]" set:html={rich(home.aboutTitle)} />
        <div class="entry mt-6" set:html={md(home.aboutBody)} />
        {isLive('/tentang') && <p class="mt-8"><a class="btn btn-primary" href="/tentang">{ui.learnMore}</a></p>}
      </div>

      <div class="mt-24">
        <p class="eyebrow">{ui.eyebrows.steps}</p>
        <h3 class="mt-3 text-[clamp(26px,3.6vw,40px)] font-bold italic leading-tight">{home.stepsTitle}</h3>
        <ol class="mt-10 grid gap-6 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-stretch">
          {
            aboutSteps.map((st, i) => (
              <Fragment>
                <li class="card-dark relative p-6">
                  <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="icon-chip icon-chip-lg"><Icon name={st.icon ?? 'star'} size={28} /></span>
                  <h4 class="mt-6 font-heading text-base font-extrabold uppercase">{st.title}</h4>
                  <p class="mt-2 text-sm text-dark-ink">{st.description}</p>
                </li>
                {i < aboutSteps.length - 1 && (
                  <li class="step-arrow" aria-hidden="true"><Icon name="arrow" size={30} /></li>
                )}
              </Fragment>
            ))
          }
        </ol>
      </div>

      <div class="mt-20">
        <p class="eyebrow">{home.beneficiariesTitle}</p>
        <ul class="mt-6 grid gap-4 md:grid-cols-3">
          {
            beneficiaries.map((b) => (
              <li class="card-olive flex items-center gap-4 p-5">
                <span class="icon-chip"><Icon name={b.icon ?? 'heart'} size={22} /></span>
                <span class="font-heading text-base font-bold text-white">{b.title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="dark-flow on-dark">
  <!-- 03. Event Highlights: video promo -->
  <section class="section on-dark" id="highlights">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">{ui.eyebrows.highlights}</p>
        <h2 class="rich rich-accent font-light" set:html={rich(home.highlightsTitle)} />
        <p>{home.highlightsText}</p>
      </div>
      <div class="mx-auto max-w-4xl">
        <VideoEmbed url={home.videoUrl} poster={home.videoPoster} title={`${site.eventName} — video promo`} />
      </div>
    </div>
  </section>

  <!-- 04. Race Information: kategori, jadwal, lokasi, rute -->
  <section class="section on-dark" id="race">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">{ui.eyebrows.race}</p>
        <h2 class="rich rich-accent font-light" set:html={rich(home.raceTitle)} />
        <p>{home.raceText}</p>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f) => (
            <li class="card card-accent flex flex-col gap-4 p-6">
              <span class="icon-chip"><Icon name={f.icon ?? 'star'} size={22} /></span>
              <p class="stat">{f.value}</p>
              <p class="mt-auto text-sm text-dark-ink">{f.note}</p>
            </li>
          ))
        }
      </ul>

      <div class="card mt-4 flex flex-wrap items-center gap-6  p-6 md:p-8">
        <span class="icon-chip icon-chip-lg hidden sm:grid"><Icon name="ticket" size={28} /></span>
        <div class="flex-1">
          <p class="eyebrow">{ui.feeLabel}</p>
          <p class="stat mt-1 !text-[clamp(22px,3vw,32px)]">{home.feeValue}</p>
          <p class="mt-2 max-w-3xl text-sm text-dark-ink">{home.feeNote}</p>
        </div>
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
      </div>

      <h3 class="mt-16 text-2xl font-light italic">{home.rundownTitle}</h3>
      <ol class="mt-6 grid gap-x-12 md:grid-cols-2 md:[grid-auto-flow:column] md:[grid-template-rows:repeat(5,minmax(0,1fr))]">
        {
          rundown.map((r) => (
            <li class="row-line">
              <span class="chip">{r.time}</span>
              <span class="font-heading text-[15px] font-semibold text-dark">{r.label}</span>
            </li>
          ))
        }
      </ol>

      <h3 class="mt-16 mb-6 text-2xl font-light italic">{home.routesTitle}</h3>
      <Tabs tabs={routeTabs} />
    </div>
  </section>

  <!-- 05. Prizes & Racepack -->
  <section class="section on-dark" id="prizes">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">{ui.eyebrows.prizes}</p>
        <h2 class="rich rich-accent font-light" set:html={rich(home.prizesTitle)} />
        <p>{home.prizesText}</p>
      </div>

      <h3 class="join-group">{ui.prizesHeading}</h3>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          prizes.map((p) => (
            <li class="card-dark prize-card">
              <div class="prize-media">
                <span class="prize-qty num text-4xl">{p.quantity}<span class="text-xl">×</span></span>
                {p.image
                  ? <img src={img(p.image.url, 700)} alt={p.image.alt ?? p.title} width={p.image.width ?? undefined} height={p.image.height ?? undefined} loading="lazy" />
                  : <span class="icon-chip icon-chip-lg"><Icon name={p.icon ?? 'trophy'} size={28} /></span>}
              </div>
              <div class="prize-body">
                <p class="font-heading text-base font-bold">{p.title}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="block-divider" aria-hidden="true"></div>

      <h3 class="join-group">{home.racepackTitle}</h3>
      <p class="-mt-2 mb-8 max-w-2xl text-dark-ink">{home.racepackText}</p>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <Photo image={home.racepackImage} alt="Isi race pack" width={1200} ratio="1700/1068" dark label="Race pack" class="rounded-card" />
        <div>
          <ul class="grid gap-3 sm:grid-cols-2">
            {
              racepackItems.map((it) => (
                <li class="card-dark flex items-start gap-3 p-4">
                  <span class="icon-chip !h-10 !w-10"><Icon name={it.icon ?? 'star'} size={18} /></span>
                  <div>
                    <p class="font-heading text-sm font-bold">{it.title}</p>
                    <p class="text-xs text-white/65">{it.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="mt-8"><a class="btn" href="/racepack">{ui.seeRacepack}</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. How to Join -->
  <section class="section on-dark" id="join">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">{ui.eyebrows.join}</p>
        <h2 class="rich rich-accent font-light" set:html={rich(home.joinTitle)} />
        <p>{home.joinText}</p>
      </div>
      <h3 class="join-group">{ui.joinRegister}</h3>
      <ol class="grid gap-5 md:grid-cols-3">
        {
          joinSteps.map((s, i) => (
            <li class="card card-accent p-7">
              <div class="flex items-center justify-between">
                <span class="icon-chip icon-chip-lg"><Icon name={s.icon ?? 'star'} size={28} /></span>
                <span class="num text-5xl">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h4 class="mt-5 text-lg">{s.title}</h4>
              <p class="mt-2 text-sm text-dark-ink">{s.description}</p>
            </li>
          ))
        }
      </ol>
      {site.registrationUrl && <p class="mt-8 text-center"><a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a></p>}

      <h3 class="join-group mt-16">{ui.joinCollect}</h3>
      <ol class="grid gap-5 md:grid-cols-3">
        {
          racepack.steps.map((s, i) => (
            <li class="card card-accent p-7">
              <div class="flex items-center justify-between">
                <span class="icon-chip icon-chip-lg"><Icon name={s.icon ?? 'star'} size={28} /></span>
                <span class="num text-5xl">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h4 class="mt-5 text-lg">{s.title}</h4>
              <p class="mt-2 text-sm text-dark-ink">{s.description}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-center"><a class="btn btn-outline" href="/racepack">{ui.seeRacepack}</a></p>
    </div>
  </section>
  </div>

  <!-- 07. FAQ & Contact -->
  <section class="section bg-alt" id="faq">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">{ui.eyebrows.faq}</p>
        <h2 class="rich rich-accent font-light text-primary" set:html={rich(home.faqTitle)} />
        <p>{home.faqText}</p>
      </div>
      <div class="grid items-start gap-8 lg:grid-cols-[1.6fr_1fr]">
        <div>
          {
            faqs.map((f, i) => (
              <details class="faq" name="faq" open={i === 0}>
                <summary>{f.question}</summary>
                <div class="entry" set:html={md(f.answer)} />
              </details>
            ))
          }
        </div>
        <aside class="card card-accent p-7 lg:sticky lg:top-28">
          <h3 class="text-xl">{home.contactTitle}</h3>
          <p class="mt-2 text-sm text-ink-soft">{home.contactText}</p>
          <div class="mt-6"><ContactList contacts={contacts} websiteUrl={site.websiteUrl} email={site.contactUrl} /></div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Sponsor (ditampilkan bila ada) -->
  {
    groups.size > 0 && (
      <section class="bg-dark-section py-14 on-dark" aria-label={ui.sponsorsTitle}>
        <div class="container-x">
          <p class="eyebrow text-center">{ui.sponsorsTitle}</p>
          <div class="mt-8 flex flex-wrap items-start justify-center gap-x-16 gap-y-8">
            {[...groups].map(([role, list]) => (
              <div class="text-center">
                <div class="mb-3 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60">{role}</div>
                <div class="flex items-center justify-center gap-6">
                  {list.map((s) => {
                    const inner = s.logo
                      ? <img src={img(s.logo.url, 320)} alt={s.name} width={s.logo.width ?? 240} height={s.logo.height ?? 64} class="h-10 w-auto" loading="lazy" />
                      : <span class="font-heading text-sm font-bold">{s.name}</span>;
                    return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
