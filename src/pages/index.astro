---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import Photo from '../components/Photo.astro';
import Steps from '../components/Steps.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Icon from '../components/Icon.astro';
import RouteTabs from '../components/RouteTabs.astro';
import Prizes from '../components/Prizes.astro';
import ContactList from '../components/ContactList.astro';
import { getSiteData, getAbout, getHome, getContact, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { md, rich } from '../lib/text';
import { ui } from '../config';
import { venuePhotos, racepackPhoto, eventBackdrop, aboutQuote } from '../lib/fallback';

const { site, sponsors } = await getSiteData();
const { about, faqs } = await getAbout();
const { home, categories, raceInfo, prizes, items, joinSteps } = await getHome();
const contact = await getContact();

// Race Information: fakta besar + rundown, semuanya dari data (tabel markdown di raceInfo.scheduleDetail)
const rundown = (raceInfo.scheduleDetail ?? '')
  .split('\n')
  .filter((l) => l.startsWith('|'))
  .map((l) => l.split('|').slice(1, -1).map((c) => c.trim()))
  .filter((c) => c.length >= 2 && /^\d/.test(c[0]))
  .map(([time, event]) => ({ time, event }));
// About: langkah konsep sosial dan penerima manfaat diurai dari about.mission (markdown dari proposal hal. 4)
const mLines = (about.mission ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
const flowTitle = mLines.find((l) => /^\*\*[^*]+\*\*$/.test(l))?.replace(/\*\*/g, '') ?? '';
const flow = mLines
  .map((l) => l.match(/^\d+\.\s+\*\*(.+?)\*\*\s*(.+)$/))
  .filter((m): m is RegExpMatchArray => !!m)
  .map((m) => ({ title: m[1].replace(/:$/, ''), text: m[2] }));
const benefLine = mLines.find((l) => /^\*\*Penerima/i.test(l));
const benefLabel = benefLine?.match(/^\*\*(.+?)\*\*/)?.[1].replace(/:$/, '') ?? '';
const beneficiaries = benefLine ? benefLine.replace(/^\*\*.+?\*\*\s*/, '').split(',').map((x) => x.trim()).filter(Boolean) : [];
const price = (d: string) => d.match(/\*\*(Rp[^*]+)\*\*/)?.[1] ?? '';
const gear = items.filter((i) => i.image);
const supplies = items.filter((i) => !i.image);

// Kelompokkan sponsor per peran, urutan mengikuti CMS (kosong = tidak ditampilkan)
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<Base description={home.metaDescription}>
  <!-- 01. HOME / HERO: KV, headline, countdown, CTA -->
  <section class="hero-poster on-dark">
    {
      site.heroImage && (
        <img
          src={img(site.heroImage.url, 2400)}
          alt={site.heroImage.alt ?? site.eventName}
          width={site.heroImage.width ?? 2400}
          height={site.heroImage.height ?? 1351}
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    <div class="container-x flex flex-wrap items-center justify-between gap-x-10 gap-y-5 py-8">
      <div>
        <h1 class="hero-eyebrow">{site.heroHeadline}</h1>
        <p class="mt-1 font-heading text-sm font-bold">{site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}</p>
      </div>
      {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
    </div>
    <Countdown target={site.eventDate} embedded />
    {
      groups.size > 0 && (
        <div class="container-x flex flex-wrap items-end gap-x-10 gap-y-4 pb-8">
          {[...groups].map(([role, list]) => (
            <div>
              <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60">{role}</div>
              <div class="flex items-center gap-4">
                {list.map((s) => {
                  const inner = s.logo
                    ? <img src={img(s.logo.url, 240)} alt={s.name} class="h-8 w-auto" loading="lazy" />
                    : <span class="font-heading text-sm font-bold">{s.name}</span>;
                  return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
                })}
              </div>
            </div>
          ))}
        </div>
      )
    }
    <div class="stripe-band" aria-hidden="true"></div>
  </section>

  <!-- 02. ABOUT ANSORUN: tentang event dan misi sosial -->
  <section class="section bg-pattern" id="tentang">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(about.sectionTitle)} />
      </div>

      <div class="grid items-center gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-14">
        <p class="font-display text-[clamp(26px,3.4vw,40px)] leading-[1.15] text-primary-dark">“{aboutQuote}”</p>
        <div class="entry [&>p:first-child]:text-lg [&>p:first-child]:text-ink" set:html={md(about.body)} />
      </div>

      {
        flow.length > 0 ? (
          <div class="mt-12">
            {flowTitle && <h3 class="mb-5 text-center text-xl">{flowTitle}</h3>}
            <ol class="grid gap-4 md:grid-cols-3">
              {flow.map((f, i) => (
                <li class="flow-tile">
                  <span class="n">{String(i + 1).padStart(2, '0')}</span>
                  <h4 class="mt-2 text-base">{f.title}</h4>
                  <p class="mt-1 text-sm">{f.text}</p>
                </li>
              ))}
            </ol>
            {beneficiaries.length > 0 && (
              <p class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm">
                <strong class="font-heading text-ink">{benefLabel}</strong>
                {beneficiaries.map((b) => <span class="rounded-full border border-line bg-paper px-4 py-1.5 font-semibold text-primary-dark">{b}</span>)}
              </p>
            )}
          </div>
        ) : (
          about.mission && <div class="entry mt-8" set:html={md(about.mission)} />
        )
      }
    </div>
  </section>

  <!-- 03. EVENT HIGHLIGHTS: video promo -->
  <section class="section bg-fade" id="video">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(home.videoTitle)} />
      </div>
      <div class="photo-bg on-dark mx-auto max-w-5xl overflow-hidden rounded-[6px] p-4 md:p-10" style={`background-image:url(${eventBackdrop.url})`}>
        <VideoEmbed youtubeId={home.videoId} />
      </div>
    </div>
  </section>

  <!-- 04. RACE INFORMATION: kategori, jadwal, lokasi (rute di section berikutnya) -->
  <section class="section bg-fade" id="race">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(home.raceTitle)} />
      </div>

      <div class="grid gap-8 md:grid-cols-3 md:gap-0">
        <div class="fact" id="jadwal-ringkas">
          <span class="step-icon mx-auto mb-4"><Icon name="calendar" size={24} /></span>
          <p class="fact-value">{raceInfo.scheduleDate}</p>
          <p class="fact-sub">05.30 – 11.30 WIB</p>
        </div>
        <div class="fact" id="lokasi">
          <span class="step-icon mx-auto mb-4"><Icon name="pin" size={24} /></span>
          <p class="fact-value">{raceInfo.locationName}</p>
          <p class="fact-sub">{raceInfo.locationAddress}{raceInfo.locationMapUrl && <> · <a href={raceInfo.locationMapUrl} rel="noopener" target="_blank">{ui.openMap}</a></>}</p>
        </div>
        <div class="fact" id="kategori">
          <span class="step-icon mx-auto mb-4"><Icon name="route" size={24} /></span>
          <p class="fact-value">{categories.map((c) => c.name).join(' & ')}</p>
          <p class="fact-sub">{categories.map((c) => `${c.name} ${price(c.detail)}`).join(' · ')}</p>
        </div>
      </div>

      <div class="mt-10 grid items-start gap-8 lg:grid-cols-2">
        {
          rundown.length > 0 && (
            <div id="jadwal">
              <h3 class="mb-3 text-xl">Rundown Race Day (Tentatif)</h3>
              <ol>
                {rundown.map((r) => (
                  <li class="time-row"><span class="t">{r.time}</span><span>{r.event}</span></li>
                ))}
              </ol>
            </div>
          )
        }
        <div class="grid gap-3">
          {venuePhotos.map((v) => <div class="photo-matte"><img src={v.url} alt={v.alt ?? ''} width={v.width ?? 1400} height={v.height ?? 800} class="photo-frame-wide" loading="lazy" decoding="async" /></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 04b. RUTE: section sendiri (dipisah dari Race Information atas permintaan) -->
  <section class="section bg-pattern" id="rute">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(home.routeTitle)} />
        {raceInfo.routeDetail && <div class="entry mt-3" set:html={md(raceInfo.routeDetail)} />}
      </div>
      <RouteTabs items={categories} />
      {raceInfo.routeMapUrl && <p class="mt-8 text-center"><a class="btn btn-blue" href={raceInfo.routeMapUrl} rel="noopener" target="_blank"><Icon name="route" size={16} /> {ui.openMap}</a></p>}
    </div>
  </section>

  <!-- 05. PRIZES & RACEPACK: hadiah dan perlengkapan peserta (proposal hal. 13 dan 10) -->
  <section class="section bg-fade" id="hadiah">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(home.prizesTitle)} />
      </div>

      <h3 class="mb-6 text-center text-xl">{ui.prizesSub}</h3>
      <Prizes prizes={prizes} />

      <h3 id="racepack" class="mb-6 mt-14 scroll-mt-24 text-center text-xl">{ui.racepackSub}</h3>
      <div class="grid items-start gap-6 lg:grid-cols-[1.2fr_1fr]">
        <div class="photo-matte"><img src={racepackPhoto.url} alt={racepackPhoto.alt ?? ''} width={racepackPhoto.width ?? 1578} height={racepackPhoto.height ?? 997} loading="lazy" decoding="async" /></div>
        <div class="grid grid-cols-2 gap-x-5 gap-y-6">
          {
            gear.map((g) => (
              <div>
                <Photo image={g.image} alt={g.title} width={500} ratio="4/3" fit="contain" />
                <h4 class="mt-2 text-base">{g.title}</h4>
                <p class="text-sm leading-snug">{g.description}</p>
              </div>
            ))
          }
        </div>
      </div>
      {
        supplies.length > 0 && (
          <ul class="mt-8 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
            {supplies.map((it) => (
              <li class="border-t border-line py-2.5">
                <p class="font-heading font-bold text-ink">{it.title}</p>
                <p class="text-sm leading-snug">{it.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- 06. HOW TO JOIN: pendaftaran dan race pack collection -->
  <section class="section bg-pattern" id="daftar">
    <div class="container-x">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(home.joinTitle)} />
      </div>
      <Steps steps={joinSteps} />
      <p class="mt-10 flex flex-wrap justify-center gap-3">
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
        <a class="btn btn-blue" href="/racepack">{ui.howToJoinCta}</a>
      </p>
    </div>
  </section>

  <!-- 07. FAQ & CONTACT: informasi tambahan dan kontak -->
  <section class="section bg-fade" id="faq">
    <div class="container-x max-w-3xl">
      <div class="section-heading">
        <h2 class="rich rich-accent" set:html={rich(about.faqTitle)} />
      </div>
      {
        faqs.map((f) => (
          <details class="faq">
            <summary>{f.question}</summary>
            <div class="entry" set:html={md(f.answer)} />
          </details>
        ))
      }
      <div class="mt-14" id="kontak">
        <h3 class="mb-4 text-center text-lg">{ui.contactLabel}</h3>
        <ContactList contact={contact} />
      </div>
    </div>
  </section>
</Base>
