---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import RacepackViewer from '../components/RacepackViewer.astro';
import Steps from '../components/Steps.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Icon from '../components/Icon.astro';
import RouteTabs from '../components/RouteTabs.astro';
import Prizes from '../components/Prizes.astro';
import ContactList from '../components/ContactList.astro';
import { getSiteData, getAbout, getHome, getContact, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { md, rich } from '../lib/text';
import { ui } from '../config';

const { site, sponsors } = await getSiteData();
const { about, faqs } = await getAbout();
const { home, categories, raceInfo, prizes, items, joinSteps } = await getHome();
const contact = await getContact();

// Kelompokkan sponsor per peran, urutan mengikuti CMS (kosong = tidak ditampilkan)
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<Base description={home.metaDescription}>
  <!-- 01. HOME / HERO: KV, headline, countdown, CTA -->
  <section class="hero-poster on-dark">
    {
      site.heroImage && (
        <div class="hero-poster-media">
          <img
            src={img(site.heroImage.url, 2400)}
            alt={site.heroImage.alt ?? site.eventName}
            width={site.heroImage.width ?? 2400}
            height={site.heroImage.height ?? 1351}
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-fade-bottom" aria-hidden="true" />
        </div>
      )
    }
    <div class="container-x flex flex-col items-center text-center gap-4 py-8">
      <h1 class="hero-eyebrow text-accent">{site.heroHeadline}</h1>
      <p class="font-heading text-sm sm:text-base font-bold text-white/90">{site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}</p>
      {site.registrationUrl && <div class="mt-2"><a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a></div>}
    </div>
    <Countdown target={site.eventDate} embedded />
    {
      groups.size > 0 && (
        <div class="container-x flex flex-wrap items-center justify-center gap-x-12 gap-y-6 pb-8 text-center">
          {[...groups].map(([role, list]) => (
            <div>
              <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60">{role}</div>
              <div class="flex items-center justify-center gap-4">
                {list.map((s) => {
                  const inner = s.logo
                    ? <img src={img(s.logo.url, 240)} alt={s.name} class="h-8 w-auto" loading="lazy" />
                    : <span class="font-heading text-sm font-bold">{s.name}</span>;
                  return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
                })}
              </div>
            </div>
          ))}
        </div>
      )
    }
    <div class="stripe-band" aria-hidden="true"></div>
  </section>

  <!-- 02. ABOUT ANSORUN: tentang event dan konsep sosial dari PDF -->
  <section class="section section-about" id="tentang">
    <div class="container-x">
      <div class="section-heading !mb-10">
        <h1 class="rich rich-accent text-3xl sm:text-4xl lg:text-5xl font-extrabold uppercase tracking-wide">
          TENTANG <strong>EVENT</strong>
        </h1>
      </div>

      <!-- 3 Kartu Konsep Sosial dari Proposal PDF -->
      <div class="grid gap-5 md:grid-cols-3">
        <div class="concept-card">
          <span class="concept-num">01</span>
          <h3>Pendaftaran</h3>
          <p>Kategori 5K (Rp150.000) dan 10K (Rp200.000). Sudah termasuk paket racepack resmi lengkap.</p>
        </div>

        <div class="concept-card">
          <span class="concept-num">02</span>
          <h3>Konversi Takjil</h3>
          <p>Sebagian besar hasil pendaftaran dibelanjakan menjadi ribuan paket takjil buka puasa.</p>
        </div>

        <div class="concept-card">
          <span class="concept-num">03</span>
          <h3>Berbagi dari Pelari</h3>
          <p>Disalurkan langsung oleh GP Ansor bersama komunitas lintas agama kepada panti asuhan yatim piatu, panti jompo, dan warga prasejahtera.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. EVENT HIGHLIGHTS: video promo -->
  <section class="section" id="video">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Highlight Event</p>
        <h2 class="rich rich-accent" set:html={rich(home.videoTitle)} />
      </div>
      <div class="mx-auto max-w-4xl">
        <VideoEmbed youtubeId={home.videoId} />
      </div>
    </div>
  </section>

  <!-- 04. RACE INFORMATION: kategori, jadwal, lokasi, rute -->
  <section class="section" id="race">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Informasi Lomba</p>
        <h2 class="rich rich-accent" set:html={rich(home.raceTitle)} />
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Kategori -->
        <div class="card p-7" id="kategori">
          <p class="eyebrow">Kategori</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {
              categories.map((c) => (
                <div class="rounded-[4px] bg-alt/50 p-5 border border-line">
                  <p class="font-display text-4xl text-accent">{c.name}</p>
                  <div class="entry mt-2 text-sm text-dark-ink" set:html={md(c.detail)} />
                </div>
              ))
            }
          </div>
        </div>

        <!-- Lokasi -->
        <div class="card p-7" id="lokasi">
          <p class="eyebrow">Lokasi</p>
          <h3 class="mt-4 text-xl text-white">{raceInfo.locationName}</h3>
          {raceInfo.locationAddress && <p class="mt-2 text-sm text-dark-ink">{raceInfo.locationAddress}</p>}
          {raceInfo.locationMapImage && <img src={img(raceInfo.locationMapImage.url, 900)} alt={raceInfo.locationMapImage.alt ?? 'Peta lokasi'} class="mt-4 w-full rounded-[4px]" loading="lazy" />}
          {raceInfo.locationMapUrl && <p class="mt-5"><a class="btn btn-blue" href={raceInfo.locationMapUrl} rel="noopener" target="_blank"><Icon name="pin" size={16} /> {ui.openMap}</a></p>}
        </div>

        <!-- Jadwal -->
        <div class="card p-7 lg:col-span-2" id="jadwal">
          <p class="eyebrow">Jadwal</p>
          <h3 class="mt-4 text-xl text-white">{raceInfo.scheduleDate}</h3>
          <div class="entry mt-3 text-sm overflow-x-auto text-dark-ink" set:html={md(raceInfo.scheduleDetail)} />
        </div>
      </div>
    </div>
  </section>

  <!-- 04b. RUTE: section rute dengan tab interaktif & peta zoomable -->
  <section class="section" id="rute">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Peta Lintasan</p>
        <h2 class="rich rich-accent" set:html={rich(home.routeTitle)} />
        {raceInfo.routeDetail && <div class="entry mt-3 text-dark-ink" set:html={md(raceInfo.routeDetail)} />}
      </div>
      <RouteTabs items={categories} />
      {raceInfo.routeMapUrl && <p class="mt-8 text-center"><a class="btn btn-blue" href={raceInfo.routeMapUrl} rel="noopener" target="_blank"><Icon name="route" size={16} /> {ui.openMap}</a></p>}
    </div>
  </section>

  <!-- 05a. PRIZES: hadiah -->
  <section class="section" id="hadiah">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Hadiah & Doorprize</p>
        <h2 class="rich rich-accent" set:html={rich(home.prizesTitle)} />
      </div>
      <Prizes prizes={prizes} />
    </div>
  </section>

  <!-- 05b. RACEPACK: perlengkapan peserta -->
  <section class="section" id="racepack">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Perlengkapan Peserta</p>
        <h2 class="rich rich-accent" set:html={rich(home.racepackTitle)} />
      </div>
      <RacepackViewer venue={ui.racepackItemsLabel} schedule="Perlengkapan resmi lomba yang siap menemani langkah kebaikanmu." items={items} />
    </div>
  </section>

  <!-- 06. HOW TO JOIN: pendaftaran dan race pack collection -->
  <section class="section" id="daftar">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Alur Kepesertaan</p>
        <h2 class="rich rich-accent" set:html={rich(home.joinTitle)} />
      </div>
      <Steps steps={joinSteps} />
      <p class="mt-10 flex flex-wrap justify-center gap-3">
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
        <a class="btn btn-blue" href="/racepack">{ui.howToJoinCta}</a>
      </p>
    </div>
  </section>

  <!-- 07. FAQ: pertanyaan yang sering diajukan -->
  <section class="section" id="faq">
    <div class="container-x max-w-3xl">
      <div class="section-heading">
        <p class="eyebrow">Ada Pertanyaan?</p>
        <h2 class="rich rich-accent">FREQUENTLY ASKED <strong>QUESTIONS</strong></h2>
        <p class="mt-2 text-sm sm:text-base text-dark-ink">Pertanyaan umum seputar pendaftaran, kategori lomba, dan teknis race day.</p>
      </div>
      {
        faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.question}</summary>
            <div class="entry" set:html={md(f.answer)} />
          </details>
        ))
      }
    </div>
  </section>

  <!-- 08. CONTACT: informasi dan layanan narahubung -->
  <section class="section section-about" id="kontak">
    <div class="container-x">
      <div class="section-heading">
        <p class="eyebrow">Narahubung Resmi</p>
        <h2 class="rich rich-accent">LAYANAN <strong>INFORMASI & KONTAK</strong></h2>
        <p class="mt-2 text-sm sm:text-base text-dark-ink">Hubungi panitia resmi untuk informasi pendaftaran, rute, sponsorship, atau kemitraan.</p>
      </div>
      <div class="mx-auto max-w-4xl">
        <ContactList contact={contact} />
      </div>
    </div>
  </section>

  <!-- Final Call to Action Sebelum Footer -->
  {
    site.registrationUrl && (
      <section class="section text-center" aria-label="Ajak Mendaftar">
        <div class="container-x max-w-2xl">
          <p class="eyebrow">Siap Melangkah & Berbagi?</p>
          <h2 class="rich rich-accent mt-2 text-3xl sm:text-4xl">DAFTAR <strong>SEKARANG</strong></h2>
          <p class="mt-3 text-sm sm:text-base text-dark-ink">
            Ajang lari 5K & 10K menyambut Ramadan 1448 H di GBK Senayan. Tiap kilometer hadirkan kebaikan nyata.
          </p>
          <p class="mt-8 flex flex-wrap justify-center gap-4">
            <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>
            <a class="btn btn-outline" href="/racepack">{ui.howToJoinCta}</a>
          </p>
        </div>
      </section>
    )
  }
</Base>
