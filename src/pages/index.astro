---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Tabs from '../components/Tabs.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import ContactList from '../components/ContactList.astro';
import { getSiteData, getHome, getFaqs, getContacts, getRacepackItems, getRacepack, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { md, plain, rich } from '../lib/text';
import { ui } from '../config';
import { isLive } from '../lib/pages.mjs';

const { site, sponsors } = await getSiteData();
const { home, aboutSteps, beneficiaries, facts, rundown, routes, prizes, joinSteps } = await getHome();
const [faqs, contacts, racepackItems, racepack] = await Promise.all([getFaqs(), getContacts(), getRacepackItems(), getRacepack()]);

const heroBg = site.heroImage ? `background-image:url(${img(site.heroImage.url, 1920)})` : '';

// Rute lari -> isi tab
const routeTabs = routes.map((r) => ({
  title: r.title,
  content: `${r.image ? `<a class="route-map" href="${img(r.image.url, 2400)}" target="_blank" rel="noopener"><img src="${img(r.image.url, 1400)}" alt="${(r.image.alt ?? r.title).replace(/"/g, '&quot;')}" loading="lazy"></a>\n<p class="route-map-hint">${ui.mapZoom}</p>\n\n` : ''}${r.description}`,
}));

// Sponsor dikelompokkan per peran
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<Base>
  <!-- 01. Hero Section -->
  {
    site.heroKv ? (
      <section class="hero-kv on-dark">
        <h1 class="sr-only">{plain(site.eventName)} — {site.heroEyebrow}</h1>
        <div class="hero-kv-media">
          <img class="hero-kv-bg" src={img(site.heroKv.url, 2400)} alt="" aria-hidden="true" decoding="async" />
          <img
            class="hero-kv-img"
            src={img(site.heroKv.url, 2400)}
            alt={site.heroKv.alt ?? `Key visual ${plain(site.eventName)}`}
            width={site.heroKv.width ?? undefined}
            height={site.heroKv.height ?? undefined}
            fetchpriority="high"
          />
        </div>
        <div class="container-x hero-kv-bar">
          <div>
            <p class="mb-3 font-heading text-sm font-bold text-white/90">{site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}</p>
            <Countdown target={site.eventDate} />
          </div>
          <p class="flex flex-wrap gap-3">
            {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
            <a class="btn btn-outline" href="#about">{ui.explore}</a>
          </p>
        </div>
      </section>
    ) : (
      <section class="hero on-dark" style={heroBg}>
        <div class="container-x flex flex-1 flex-col justify-center py-16">
          <p class="hero-eyebrow">{site.heroEyebrow}</p>
          <h1 class="rich mt-3 max-w-3xl" set:html={rich(site.heroHeadline)} />
          <p class="mt-4 max-w-xl text-lg text-white/85">{site.heroSubheadline}</p>
          <p class="mt-3 font-heading text-sm font-bold text-white/90">
            {site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}
          </p>
          <p class="mt-6 flex flex-wrap gap-3">
            {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
            <a class="btn btn-outline" href="#about">{ui.explore}</a>
          </p>
        </div>
        <div class="container-x pb-14">
          <Countdown target={site.eventDate} />
        </div>
      </section>
    )
  }

  <div class="dark-flow on-dark">
    <!-- 02. Tentang & Konsep Sosial -->
    <section class="section on-dark" id="about">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Tentang Event</span>
          <h2 class="rich rich-accent" set:html={rich(home.aboutTitle)} />
          <div class="entry mx-auto max-w-3xl text-dark-ink" set:html={md(home.aboutBody)} />
          {isLive('/tentang') && <p class="mt-6"><a class="btn btn-primary" href="/tentang">{ui.learnMore}</a></p>}
        </div>

        {/* 3 Langkah Konsep Sosial */}
        <div class="mt-12">
          <h3 class="join-group">{home.stepsTitle}</h3>
          <ol class="mt-6 grid gap-6 md:grid-cols-3">
            {
              aboutSteps.map((st, i) => (
                <li class="card-dark relative p-8">
                  <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="icon-chip icon-chip-lg"><Icon name={st.icon ?? 'star'} size={28} /></span>
                  <h4 class="mt-6 font-heading text-base font-extrabold uppercase text-white">{st.title}</h4>
                  <p class="mt-2 text-sm text-dark-ink">{st.description}</p>
                </li>
              ))
            }
          </ol>
        </div>

        {/* Penerima Manfaat */}
        <div class="mt-12">
          <h3 class="join-group">{home.beneficiariesTitle}</h3>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {
              beneficiaries.map((b) => (
                <li class="card-olive flex items-center gap-4 p-6">
                  <span class="icon-chip"><Icon name={b.icon ?? 'heart'} size={22} /></span>
                  <span class="font-heading text-base font-bold text-white">{b.title}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 03. Event Highlights (Video Promo) -->
    <section class="section on-dark" id="highlights">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Event Highlights</span>
          <h2 class="rich rich-accent" set:html={rich(home.highlightsTitle)} />
          <p class="text-dark-ink">{home.highlightsText}</p>
        </div>
        <div class="mx-auto max-w-4xl">
          <VideoEmbed url={home.videoUrl} poster={home.videoPoster} title={`${site.eventName} — video promo`} />
        </div>
      </div>
    </section>

    <!-- 04. Race Information -->
    <section class="section on-dark" id="race">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Race Information</span>
          <h2 class="rich rich-accent" set:html={rich(home.raceTitle)} />
          <p class="text-dark-ink">{home.raceText}</p>
        </div>

        {/* 4 Fakta Utama */}
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            facts.map((f) => (
              <li class="card-dark flex flex-col gap-4 p-6">
                <span class="icon-chip"><Icon name={f.icon ?? 'star'} size={22} /></span>
                <p class="stat">{f.value}</p>
                <p class="mt-auto text-sm text-dark-ink">{f.note}</p>
              </li>
            ))
          }
        </ul>

        {/* Biaya Pendaftaran & CTA Tiket */}
        <div class="card-dark mt-6 flex flex-wrap items-center justify-between gap-6 p-6 sm:p-8">
          <div class="flex items-center gap-5">
            <span class="icon-chip icon-chip-lg hidden sm:grid"><Icon name="ticket" size={28} /></span>
            <div>
              <p class="eyebrow">{ui.feeLabel}</p>
              <p class="stat mt-1 !text-3xl text-white">{home.feeValue}</p>
              <p class="mt-1 text-sm text-dark-ink">{home.feeNote}</p>
            </div>
          </div>
          {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
        </div>

        {/* Rundown */}
        <div class="mt-12">
          <h3 class="join-group">{home.rundownTitle}</h3>
          <ol class="mt-6 grid gap-x-12 md:grid-cols-2 md:[grid-auto-flow:column] md:[grid-template-rows:repeat(5,minmax(0,1fr))]">
            {
              rundown.map((r) => (
                <li class="row-line">
                  <span class="chip">{r.time}</span>
                  <span class="font-heading text-sm font-semibold text-white">{r.label}</span>
                </li>
              ))
            }
          </ol>
        </div>

        {/* Rute Lari */}
        <div class="mt-12">
          <h3 class="join-group">{home.routesTitle}</h3>
          <Tabs tabs={routeTabs} />
        </div>
      </div>
    </section>

    <!-- 05. Prizes & Racepack -->
    <section class="section on-dark" id="prizes">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Hadiah & Perlengkapan</span>
          <h2 class="rich rich-accent" set:html={rich(home.prizesTitle)} />
          <p class="text-dark-ink">{home.prizesText}</p>
        </div>

        {/* Hadiah Utama */}
        <h3 class="join-group">{ui.prizesHeading}</h3>
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            prizes.map((p) => (
              <li class="card-dark prize-card">
                <div class="prize-media">
                  <span class="prize-qty num text-4xl">{p.quantity}<span class="text-xl">×</span></span>
                  {p.image
                    ? <img src={img(p.image.url, 700)} alt={p.image.alt ?? p.title} width={p.image.width ?? undefined} height={p.image.height ?? undefined} loading="lazy" />
                    : <span class="icon-chip icon-chip-lg"><Icon name={p.icon ?? 'trophy'} size={28} /></span>}
                </div>
                <div class="prize-body">
                  <p class="font-heading text-base font-bold text-white">{p.title}</p>
                </div>
              </li>
            ))
          }
        </ul>

        {/* Cuplikan Racepack (Layout 2 Kolom Seimbang) */}
        <div class="mt-12">
          <h3 class="join-group">{home.racepackTitle}</h3>
          <p class="-mt-3 mb-8 max-w-2xl text-dark-ink">{home.racepackText}</p>
          <div class="grid items-center gap-8 lg:grid-cols-2">
            <Photo image={home.racepackImage} alt="Isi race pack" width={1200} ratio="1700/1068" dark label="Race pack" class="rounded-card" />
            <div class="card-dark flex flex-col justify-between p-8">
              <h4 class="font-heading text-base font-bold text-white">Item Paket Lomba Resmi</h4>
              <ul class="mt-4 divide-y divide-card-line">
                {
                  racepackItems.slice(0, 5).map((it) => (
                    <li class="flex items-center gap-3 py-3">
                      <span class="text-accent"><Icon name={it.icon ?? 'star'} size={18} /></span>
                      <span class="font-heading text-sm font-semibold text-white">{it.title}</span>
                      <span class="ml-auto text-xs text-dark-ink">{it.description}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="mt-6 border-t border-card-line pt-6">
                <a class="btn btn-outline" href="/racepack">{ui.seeRacepack}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 06. How to Join -->
    <section class="section on-dark" id="join">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Cara Bergabung</span>
          <h2 class="rich rich-accent" set:html={rich(home.joinTitle)} />
          <p class="text-dark-ink">{home.joinText}</p>
        </div>

        {/* Pendaftaran */}
        <h3 class="join-group">{ui.joinRegister}</h3>
        <ol class="grid gap-6 md:grid-cols-3">
          {
            joinSteps.map((s, i) => (
              <li class="card-dark relative p-8">
                <span class="num absolute right-6 top-6 text-5xl">{String(i + 1).padStart(2, '0')}</span>
                <span class="icon-chip icon-chip-lg"><Icon name={s.icon ?? 'star'} size={28} /></span>
                <h4 class="mt-6 text-lg font-bold text-white">{s.title}</h4>
                <p class="mt-2 text-sm text-dark-ink">{s.description}</p>
              </li>
            ))
          }
        </ol>
        {site.registrationUrl && (
          <p class="mt-8 text-center">
            <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>
          </p>
        )}

        {/* Pengambilan Racepack */}
        <div class="mt-12">
          <h3 class="join-group">{ui.joinCollect}</h3>
          <ol class="grid gap-6 md:grid-cols-3">
            {
              racepack.steps.map((s, i) => (
                <li class="card-dark relative p-8">
                  <span class="num absolute right-6 top-6 text-5xl">{String(i + 1).padStart(2, '0')}</span>
                  <span class="icon-chip icon-chip-lg"><Icon name={s.icon ?? 'star'} size={28} /></span>
                  <h4 class="mt-6 text-lg font-bold text-white">{s.title}</h4>
                  <p class="mt-2 text-sm text-dark-ink">{s.description}</p>
                </li>
              ))
            }
          </ol>
          <p class="mt-8 text-center">
            <a class="btn btn-outline" href="/racepack">{ui.seeRacepack}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 07. FAQ & Contact (Konsisten di Alur Gelap Kaca) -->
    <section class="section on-dark" id="faq">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Pertanyaan Umum</span>
          <h2 class="rich rich-accent" set:html={rich(home.faqTitle)} />
          <p class="text-dark-ink">{home.faqText}</p>
        </div>
        <div class="mx-auto max-w-3xl">
          {
            faqs.map((f) => (
              <details class="faq on-dark mb-3 overflow-hidden rounded-card" name="faq">
                <summary>{f.question}</summary>
                <div class="entry" set:html={md(f.answer)} />
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Kontak Panitia -->
    <section class="section on-dark pt-0" id="kontak">
      <div class="container-x">
        <div class="section-heading">
          <span class="eyebrow">Hubungi Kami</span>
          <h2 class="rich rich-accent" set:html={rich(home.contactTitle)} />
          <p class="text-dark-ink">{home.contactText}</p>
        </div>
        <div class="card-dark mx-auto max-w-3xl p-8">
          <ContactList contacts={contacts} websiteUrl={site.websiteUrl} email={site.contactUrl} columns />
        </div>
      </div>
    </section>

    <!-- Final Call to Action Banner Sebelum Footer -->
    {
      site.registrationUrl && (
        <section class="section on-dark pt-0" aria-label="Ajak Mendaftar">
          <div class="container-x">
            <div class="card-dark relative overflow-hidden p-8 text-center sm:p-12">
              <span class="eyebrow">Ajang Lari & Berbagi</span>
              <h2 class="rich rich-accent mt-2 text-2xl sm:text-3xl lg:text-4xl">
                Siap Melangkah & Hadirkan Kebaikan?
              </h2>
              <p class="mx-auto mt-3 max-w-xl text-sm sm:text-base text-dark-ink">
                Ambil bagian dalam ajang lari 5K & 10K untuk menyambut Ramadhan 1448 H. Kuota terbatas!
              </p>
              <p class="mt-6 flex flex-wrap justify-center gap-4">
                <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>
                <a class="btn btn-outline" href="/racepack">{ui.seeRacepack}</a>
              </p>
            </div>
          </div>
        </section>
      )
    }
  </div>

  <!-- Sponsor Section -->
  {
    groups.size > 0 && (
      <section class="bg-dark-section py-14 on-dark" aria-label={ui.sponsorsTitle}>
        <div class="container-x">
          <p class="eyebrow text-center">{ui.sponsorsTitle}</p>
          <div class="mt-8 flex flex-wrap items-start justify-center gap-x-16 gap-y-8">
            {[...groups].map(([role, list]) => (
              <div class="text-center">
                <div class="mb-3 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60">{role}</div>
                <div class="flex items-center justify-center gap-6">
                  {list.map((s) => {
                    const inner = s.logo
                      ? <img src={img(s.logo.url, 320)} alt={s.name} width={s.logo.width ?? 240} height={s.logo.height ?? 64} class="h-10 w-auto" loading="lazy" />
                      : <span class="font-heading text-sm font-bold text-white">{s.name}</span>;
                    return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
