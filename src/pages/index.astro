---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import Photo from '../components/Photo.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MatteImage from '../components/MatteImage.astro';
import RouteTabs from '../components/RouteTabs.astro';
import Prizes from '../components/Prizes.astro';
import ContactList from '../components/ContactList.astro';
import { getSiteData, getAbout, getHome, getContact, formatDate } from '../lib/content';
import { img } from '../lib/datocms';
import { md, rich } from '../lib/text';
import { parseRundown, parseMission, priceOf, splitLead } from '../lib/parse';
import { ui } from '../config';
import { venuePhotos, racepackPhoto, eventBackdrop, aboutQuote } from '../lib/fallback'; // TODO: pindah ke CMS bila klien ingin mengganti foto sendiri

const { site, sponsors } = await getSiteData();
const { about, faqs } = await getAbout();
const { home, categories, raceInfo, prizes, items, joinSteps } = await getHome();
const contact = await getContact();

// Data turunan untuk tampilan (penguraian ada di lib/parse.ts)
const rundown = parseRundown(raceInfo.scheduleDetail);
const mission = parseMission(about.mission);
const gear = items.filter((i) => i.image);
const supplies = items.filter((i) => !i.image);

// Kelompokkan sponsor per peran, urutan mengikuti CMS (kosong = tidak ditampilkan)
const groups = new Map<string, typeof sponsors>();
for (const s of sponsors) groups.set(s.role, [...(groups.get(s.role) ?? []), s]);
---

<Base description={home.metaDescription}>
  <!-- 01. HOME / HERO: KV, headline, countdown, CTA -->
  <section class="hero-poster on-dark">
    {
      site.heroImage && (
        <div class="hero-poster-media">
          <img
            src={img(site.heroImage.url, 2400)}
            alt={site.heroImage.alt ?? site.eventName}
            width={site.heroImage.width ?? 2400}
            height={site.heroImage.height ?? 1351}
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }
    <div class="container-x flex flex-col gap-5 py-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <div>
          <h1 class="hero-eyebrow">{site.heroHeadline}</h1>
          <p class="mt-1 font-heading text-sm font-bold">{site.location} &nbsp;|&nbsp; {formatDate(site.eventDate)}</p>
        </div>
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
      </div>
      <div class="lg:w-[46%]"><Countdown target={site.eventDate} embedded /></div>
    </div>
    {
      groups.size > 0 && (
        <div class="container-x flex flex-wrap items-end gap-x-10 gap-y-4 pb-8">
          {[...groups].map(([role, list]) => (
            <div>
              <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-[.2em] text-white/60">{role}</div>
              <div class="flex items-center gap-4">
                {list.map((s) => {
                  const inner = s.logo
                    ? <img src={img(s.logo.url, 240)} alt={s.name} class="h-8 w-auto" loading="lazy" />
                    : <span class="font-heading text-sm font-bold">{s.name}</span>;
                  return s.url ? <a href={s.url} rel="noopener" target="_blank">{inner}</a> : inner;
                })}
              </div>
            </div>
          ))}
        </div>
      )
    }
    <div class="stripe-band" aria-hidden="true"></div>
  </section>

  <!-- 02. ABOUT ANSORUN: tentang event dan misi sosial -->
  <section class="section bg-fade" id="tentang">
    <div class="container-x">
      <!-- Judul + kutipan di kiri, teks di kanan -->
      <div class="grid items-stretch gap-8 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.5fr)] lg:gap-12">
        <div class="flex flex-col">
          <h2 class="rich rich-accent text-[clamp(36px,4.6vw,56px)] leading-[1.02]" set:html={rich(about.sectionTitle)} />
          <div class="mt-5 h-1 w-14 bg-primary"></div>
          <p class="mt-6 font-display text-[clamp(22px,2.3vw,28px)] leading-[1.2] text-primary-dark lg:mt-auto">“{aboutQuote}”</p>
        </div>
        <div class="entry [&>p:first-child]:text-xl [&>p:first-child]:text-ink" set:html={md(about.body)} />
      </div>

      <!-- Konsep sosial (proposal hal. 4) -->
      {
        mission.flow.length > 0 ? (
          <div class="mt-10">
            {mission.title && <h3 class="mb-5 text-center text-xl">{mission.title}</h3>}
            <ol class="grid gap-5 md:grid-cols-3">
              {mission.flow.map((f, i) => (
                <li class="flow-tile">
                  <span class="n">{String(i + 1).padStart(2, '0')}</span>
                  <h4 class="mt-2 text-base">{f.title}</h4>
                  <p class="mt-1 text-sm">{f.text}</p>
                </li>
              ))}
            </ol>
            {mission.beneficiaries.length > 0 && (
              <div class="fade-x mt-6 flex flex-col items-center justify-center gap-x-6 gap-y-3 bg-tint px-10 py-4 md:flex-row">
                <strong class="font-heading text-ink">{mission.beneficiariesLabel}</strong>
                <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold text-primary-dark">
                  {mission.beneficiaries.map((b) => <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-primary"></span>{b}</li>)}
                </ul>
              </div>
            )}
          </div>
        ) : (
          about.mission && <div class="entry mt-10" set:html={md(about.mission)} />
        )
      }
    </div>
  </section>

  <!-- 03. EVENT HIGHLIGHTS: video promo -->
  <section class="section photo-bg on-dark" id="video" style={`background-image:url(${eventBackdrop.url})`}>
    <div class="container-x">
      <SectionHeading title={home.videoTitle} />
      <div class="mx-auto max-w-4xl">
        <VideoEmbed youtubeId={home.videoId} />
      </div>
    </div>
  </section>

  <!-- 04. RACE INFORMATION: kategori, jadwal, lokasi (rute di section berikutnya) -->
  <section class="section bg-fade" id="race">
    <div class="container-x">
      <SectionHeading title={home.raceTitle} />

      <div class="grid gap-8 md:grid-cols-3 md:gap-0">
        <div class="fact" id="jadwal-ringkas">
          <span class="step-icon mx-auto mb-2"><Icon name="calendar" size={20} /></span>
          <p class="fact-value">{raceInfo.scheduleDate}</p>
          <p class="fact-sub">05.30 – 11.30 WIB</p>
        </div>
        <div class="fact" id="lokasi">
          <span class="step-icon mx-auto mb-2"><Icon name="pin" size={20} /></span>
          <p class="fact-value">{raceInfo.locationName}</p>
          <p class="fact-sub">{raceInfo.locationAddress}{raceInfo.locationMapUrl && <> · <a href={raceInfo.locationMapUrl} rel="noopener" target="_blank">{ui.openMap}</a></>}</p>
        </div>
        <div class="fact" id="kategori">
          <span class="step-icon mx-auto mb-2"><Icon name="route" size={20} /></span>
          <p class="fact-value">{categories.map((c) => c.name).join(' & ')}</p>
          <p class="fact-sub">{categories.map((c) => `${c.name} ${priceOf(c.detail)}`).join(' · ')}</p>
        </div>
      </div>

      <div class="mt-10 grid items-center gap-8 lg:grid-cols-2">
        {
          rundown.length > 0 && (
            <div id="jadwal">
              <h3 class="sub-title mb-5 text-xl">Rundown Race Day (Tentatif)</h3>
              <ol>
                {rundown.map((r) => (
                  <li class="time-row"><span class="t">{r.time}</span><span>{r.event}</span></li>
                ))}
              </ol>
            </div>
          )
        }
        <div class="grid gap-4">
          {venuePhotos.map((v) => <MatteImage image={v} wide />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 04b. RUTE: section sendiri (dipisah dari Race Information atas permintaan) -->
  <section class="section bg-pattern" id="rute">
    <div class="container-x">
      <SectionHeading title={home.routeTitle}>
        {raceInfo.routeDetail && <div class="entry mt-1 text-sm" set:html={md(raceInfo.routeDetail)} />}
      </SectionHeading>
      <RouteTabs items={categories} />
      {raceInfo.routeMapUrl && <p class="mt-10 text-center"><a class="btn btn-blue" href={raceInfo.routeMapUrl} rel="noopener" target="_blank"><Icon name="route" size={16} /> {ui.openMap}</a></p>}
    </div>
  </section>

  <!-- 05. PRIZES & RACEPACK: hadiah (proposal hal. 13) dan perlengkapan peserta (hal. 10 dan 20), satu section -->
  <section class="section bg-fade" id="hadiah">
    <div class="container-x">
      <SectionHeading title={home.prizesTitle} />

      <h3 class="divider-label mb-6 text-xl">{ui.prizesSub}</h3>
      <Prizes prizes={prizes} />

      <div class="panel mt-12">
        <h3 id="racepack" class="divider-label mb-6 scroll-mt-24 text-xl">{ui.racepackSub}</h3>
        <div class="grid items-stretch gap-8 lg:grid-cols-[1.15fr_1fr]">
          <MatteImage image={racepackPhoto} fill />
          <div class="grid grid-cols-2 gap-x-5 gap-y-4">
            {
              gear.map((g, i) => (
                <div>
                  <div class="spot p-1"><Photo image={g.image} alt={g.title} width={420} ratio="16/10" fit="contain" class="silhouette p-1" /></div>
                  <p class="num-title mt-1"><span class="n">{String(i + 1).padStart(2, '0')}</span>{g.title}</p>
                  <p class="text-sm leading-snug">{g.description}</p>
                </div>
              ))
            }
          </div>
        </div>
        {
          supplies.length > 0 && (
            <ul class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-5">
              {supplies.map((it, i) => (
                <li>
                  <p class="num-title"><span class="n">{String(gear.length + i + 1).padStart(2, '0')}</span>{it.title}</p>
                  <p class="pb-2 text-sm leading-snug">{it.description}</p>
                </li>
              ))}
            </ul>
          )
        }
        </div>
    </div>
  </section>

  <!-- 06. HOW TO JOIN: pendaftaran dan race pack collection -->
  <section class="section bg-dark-glow on-dark" id="daftar">
    <div class="container-x">
      <SectionHeading title={home.joinTitle} />
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          joinSteps.map((st) => {
            const { lead, body } = splitLead(st.description);
            return (
              <li class:list={['tl-item', st.title === 'Race Day' && 'is-now']}>
                {lead && <p class="tl-date">{lead}</p>}
                <div class="tl-track"><span class="tl-dot"></span></div>
                <div class="card-dark tl-card">
                  <h3>{st.title}</h3>
                  <div class="entry mt-2 text-sm" set:html={md(body)} />
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="mt-10 flex flex-wrap justify-center gap-3">
        {site.registrationUrl && <a class="btn" href={site.registrationUrl}>{site.registrationLabel}</a>}
        <a class="btn btn-outline" href="/racepack">{ui.howToJoinCta}</a>
      </p>
    </div>
  </section>

  <!-- 07a. FAQ -->
  <section class="section section-flush-b bg-fade" id="faq">
    <div class="container-x max-w-3xl">
      <SectionHeading title={about.faqTitle} />
      {
        faqs.map((f) => (
          <details class="faq">
            <summary>{f.question}</summary>
            <div class="entry" set:html={md(f.answer)} />
          </details>
        ))
      }
    </div>
  </section>

  <!-- 07b. CONTACT (proposal hal. 27) -->
  <section class="section section-flush-t bg-pattern" id="kontak">
    <div class="container-x max-w-3xl">
      <SectionHeading title={ui.contactTitle} />
      <ContactList contact={contact} />
    </div>
  </section>
</Base>
