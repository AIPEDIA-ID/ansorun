# DatoCMS -> Project Settings -> API tokens -> "CDA Only (Published)" (read-only)
DATOCMS_API_TOKEN=

# Opsional: sertakan draft saat preview (true/false)
DATOCMS_DRAFTS=false

# Opsional: sandbox environment DatoCMS
DATOCMS_ENVIRONMENT=

# Hanya untuk `npm run dato:schema` -> token "Full-access API token"
DATOCMS_CMA_TOKEN=

# Domain produksi
SITE_URL=http://localhost:4321
